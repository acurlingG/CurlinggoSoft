@model CurlinggoSoft.Models.EstadoOfertaTecnico
@{ ViewData["Title"] = "Detalles Estado Oferta"; }
<h1>Detalles del Estado de Oferta</h1>
<dl class="row">
    <dt class="col-sm-2">Código</dt><dd class="col-sm-10">@Model.Codigo</dd>
    <dt class="col-sm-2">Nombre</dt><dd class="col-sm-10">@Model.Nombre</dd>
</dl>
<div>
    <a asp-action="Edit" asp-route-id="@Model.EstadoOfertaID" class="btn btn-warning">Editar</a>
    <a asp-action="Index" class="btn btn-secondary">Volver</a>
</div>
