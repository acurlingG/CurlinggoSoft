@model IEnumerable<CurlinggoSoft.Models.EstadoOfertaTecnico>
@{ ViewData["Title"] = "Estados Oferta Técnico"; }
<h1>Estados de Oferta a Técnicos</h1>
<p><a asp-action="Create" class="btn btn-primary">+ Nuevo Estado</a></p>
<table class="table table-striped table-hover">
    <thead class="table-dark">
        <tr><th>Código</th><th>Nombre</th><th>Acciones</th></tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.Codigo</td>
                <td>@item.Nombre</td>
                <td>
                    <a asp-action="Details" asp-route-id="@item.EstadoOfertaID" class="btn btn-info btn-sm">Ver</a>
                    <a asp-action="Edit" asp-route-id="@item.EstadoOfertaID" class="btn btn-warning btn-sm">Editar</a>
                    <a asp-action="Delete" asp-route-id="@item.EstadoOfertaID" class="btn btn-danger btn-sm">Eliminar</a>
                </td>
            </tr>
        }
    </tbody>
</table>
<div><a asp-action="Index" asp-controller="Admin" class="btn btn-secondary mt-3">← Volver al Admin</a></div>
