@model CurlinggoSoft.Models.SolicitudReserva
@{ ViewData["Title"] = "Eliminar Reserva"; }
<h1>Eliminar Solicitud de Reserva</h1>
<div class="alert alert-warning"><h4>¿Está seguro?</h4></div>
<dl class="row">
    <dt class="col-sm-2">Cliente</dt><dd class="col-sm-10">@Model.Cliente?.ClienteID</dd>
    <dt class="col-sm-2">Servicio</dt><dd class="col-sm-10">@Model.Servicio?.NombreServicio</dd>
</dl>
<form asp-action="Delete">
    <input type="hidden" asp-for="ReservaID" />
    <button type="submit" class="btn btn-danger">Eliminar</button>
    <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
</form>
