@model CurlinggoSoft.Models.SolicitudReserva
@{ ViewData["Title"] = "Crear Reserva"; }
<h1>Crear Solicitud de Reserva</h1>
<div class="row">
    <div class="col-md-6">
        <form asp-action="Create">
            <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
            <div class="mb-3">
                <label asp-for="ClienteID" class="form-label"></label>
                <select asp-for="ClienteID" class="form-select" asp-items="ViewBag.ClienteID"></select>
            </div>
            <div class="mb-3">
                <label asp-for="TecnicoID" class="form-label"></label>
                <select asp-for="TecnicoID" class="form-select" asp-items="ViewBag.TecnicoID"><option value="">-- Ninguno --</option></select>
            </div>
            <div class="mb-3">
                <label asp-for="ServicioID" class="form-label"></label>
                <select asp-for="ServicioID" class="form-select" asp-items="ViewBag.ServicioID"></select>
            </div>
            <div class="mb-3">
                <label asp-for="EstadoReservaID" class="form-label"></label>
                <select asp-for="EstadoReservaID" class="form-select" asp-items="ViewBag.EstadoReservaID"></select>
            </div>
            <div class="mb-3">
                <label asp-for="MontoBaseCotizado" class="form-label"></label>
                <input asp-for="MontoBaseCotizado" type="number" step="0.01" class="form-control" />
                <span asp-validation-for="MontoBaseCotizado" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="DuracionEstimadaMinutos" class="form-label"></label>
                <input asp-for="DuracionEstimadaMinutos" type="number" class="form-control" />
            </div>
            <div class="mb-3">
                <label asp-for="FechaHoraProgramada" class="form-label"></label>
                <input asp-for="FechaHoraProgramada" type="datetime-local" class="form-control" />
                <span asp-validation-for="FechaHoraProgramada" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="DireccionServicio" class="form-label"></label>
                <input asp-for="DireccionServicio" class="form-control" />
                <span asp-validation-for="DireccionServicio" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="DescripcionProblema" class="form-label"></label>
                <textarea asp-for="DescripcionProblema" class="form-control" rows="3"></textarea>
                <span asp-validation-for="DescripcionProblema" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="NotasCliente" class="form-label"></label>
                <textarea asp-for="NotasCliente" class="form-control" rows="2"></textarea>
            </div>
            <div><button type="submit" class="btn btn-primary">Guardar</button> <a asp-action="Index" class="btn btn-secondary">Cancelar</a></div>
        </form>
    </div>
</div>
@section Scripts { @{await Html.RenderPartialAsync("_ValidationScriptsPartial");} }
