@model CurlinggoSoft.Models.TecnicoEspecialidad
@{ ViewData["Title"] = "Crear Especialidad"; }
<h1>Crear Especialidad de Técnico</h1>
<div class="row">
    <div class="col-md-6">
        <form asp-action="Create">
            <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
            <div class="mb-3">
                <label asp-for="TecnicoID" class="form-label"></label>
                <select asp-for="TecnicoID" class="form-select" asp-items="ViewBag.TecnicoID"></select>
            </div>
            <div class="mb-3">
                <label asp-for="ServicioID" class="form-label"></label>
                <select asp-for="ServicioID" class="form-select" asp-items="ViewBag.ServicioID"></select>
            </div>
            <div class="mb-3">
                <label asp-for="AniosExperiencia" class="form-label"></label>
                <input asp-for="AniosExperiencia" type="number" class="form-control" />
            </div>
            <div><button type="submit" class="btn btn-primary">Guardar</button> <a asp-action="Index" class="btn btn-secondary">Cancelar</a></div>
        </form>
    </div>
</div>
@section Scripts { @{await Html.RenderPartialAsync("_ValidationScriptsPartial");} }
