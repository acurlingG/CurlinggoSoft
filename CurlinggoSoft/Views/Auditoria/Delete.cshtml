@model CurlinggoSoft.Models.Auditoria
@{ ViewData["Title"] = "Eliminar Registro de Auditoría"; }
<h1>Eliminar Registro de Auditoría</h1>
<div class="alert alert-warning"><h4>¿Está seguro?</h4></div>
<dl class="row"><dt class="col-sm-2">Tabla</dt><dd class="col-sm-10">@Model.TablaAfectada</dd></dl>
<form asp-action="Delete">
    <input type="hidden" asp-for="AuditoriaID" />
    <button type="submit" class="btn btn-danger">Eliminar</button>
    <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
</form>
