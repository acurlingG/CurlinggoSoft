@model CurlinggoSoft.Models.Auditoria
@{ ViewData["Title"] = "Detalles Auditoría"; }
<h1>Detalles de Auditoría</h1>
<dl class="row">
    <dt class="col-sm-2">Usuario</dt><dd class="col-sm-10">@Model.Usuario?.Email</dd>
    <dt class="col-sm-2">Tabla</dt><dd class="col-sm-10">@Model.TablaAfectada</dd>
    <dt class="col-sm-2">Registro</dt><dd class="col-sm-10">@Model.RegistroID</dd>
    <dt class="col-sm-2">Operación</dt><dd class="col-sm-10">@Model.Operacion</dd>
    <dt class="col-sm-2">Valores Anteriores</dt><dd class="col-sm-10">@Model.ValoresAnterioresJson</dd>
    <dt class="col-sm-2">Valores Nuevos</dt><dd class="col-sm-10">@Model.ValoresNuevosJson</dd>
    <dt class="col-sm-2">Fecha</dt><dd class="col-sm-10">@Model.FechaEvento</dd>
</dl>
<div><a asp-action="Index" class="btn btn-secondary">Volver</a></div>
