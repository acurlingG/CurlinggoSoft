@model IEnumerable<CurlinggoSoft.Models.CategoriaServicio>

@{
    ViewData["Title"] = "Categorías de Servicio";
}

<h1>Categorías de Servicio</h1>

<p>
    <a asp-action="Create" class="btn btn-primary">+ Nueva Categoría</a>
</p>

<table class="table table-striped table-hover">
    <thead class="table-dark">
        <tr>
            <th>@Html.DisplayNameFor(model => model.NombreCategoria)</th>
            <th>@Html.DisplayNameFor(model => model.Descripcion)</th>
            <th>@Html.DisplayNameFor(model => model.Activa)</th>
            <th>Acciones</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@Html.DisplayFor(modelItem => item.NombreCategoria)</td>
                <td>@Html.DisplayFor(modelItem => item.Descripcion)</td>
                <td>
                    <span class="badge @(item.Activa ? "bg-success" : "bg-danger")">
                        @(item.Activa ? "Activa" : "Inactiva")
                    </span>
                </td>
                <td>
                    <a asp-action="Edit" asp-route-categoriaid="@item.CategoriaID" class="btn btn-warning btn-sm">Editar</a>
                    <a asp-action="Details" asp-route-categoriaid="@item.CategoriaID" class="btn btn-info btn-sm">Ver</a>
                    <a asp-action="Delete" asp-route-categoriaid="@item.CategoriaID" class="btn btn-danger btn-sm">Eliminar</a>
                </td>
            </tr>
        }
    </tbody>
</table>

<div>
    <a asp-action="Index" asp-controller="Admin" class="btn btn-secondary mt-3">← Volver al Admin</a>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
