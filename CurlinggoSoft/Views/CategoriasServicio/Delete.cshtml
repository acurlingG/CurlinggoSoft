@model CurlinggoSoft.Models.CategoriaServicio

@{
    ViewData["Title"] = "Eliminar Categoría de Servicio";
}

<h1>Eliminar Categoría de Servicio</h1>

<div class="alert alert-warning" role="alert">
    <h4>¿Está seguro de que desea eliminar esta categoría?</h4>
</div>

<div>
    <h4>CurlinggoSoft.Models.CategoriaServicio</h4>
    <hr />
    <dl class="row">
        <dt class="col-sm-2">@Html.DisplayNameFor(model => model.NombreCategoria)</dt>
        <dd class="col-sm-10">@Html.DisplayFor(model => model.NombreCategoria)</dd>

        <dt class="col-sm-2">@Html.DisplayNameFor(model => model.Descripcion)</dt>
        <dd class="col-sm-10">@Html.DisplayFor(model => model.Descripcion)</dd>

        <dt class="col-sm-2">@Html.DisplayNameFor(model => model.Activa)</dt>
        <dd class="col-sm-10">
            <span class="badge @(Model.Activa ? "bg-success" : "bg-danger")">
                @(Model.Activa ? "Activa" : "Inactiva")
            </span>
        </dd>
    </dl>

    <form asp-action="Delete">
        <input type="hidden" asp-for="CategoriaID" />
        <button type="submit" class="btn btn-danger">Eliminar</button>
        <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
    </form>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
