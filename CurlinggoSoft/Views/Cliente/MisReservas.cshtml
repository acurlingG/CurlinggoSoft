@model IEnumerable<CurlinggoSoft.Models.SolicitudReserva>

@{
    ViewData["Title"] = "Mis Reservas";
}

<div class="container my-4">
    <h2 class="fw-bold mb-3"><i class="fa fa-calendar"></i> Mis Solicitudes de Servicio</h2>

    @if (!Model.Any())
    {
        <div class="alert alert-info">Aún no has realizado ninguna solicitud de servicio. <a asp-controller="SolicitudServicio" asp-action="Paso1Servicio">¡Solicita uno aquí!</a></div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-striped table-hover align-middle">
                <thead class="table-dark">
                    <tr>
                        <th>N° Reserva</th>
                        <th>Servicio</th>
                        <th>Fecha Programada</th>
                        <th>Estado</th>
                        <th>Total</th>
                        <th>Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td><code>@item.CodigoSeguimiento.ToString().Substring(0, 8)...</code></td>
                            <td>@(item.Servicio?.NombreServicio ?? "N/A")</td>
                            <td>@item.FechaHoraProgramada.ToString("dd/MM/yyyy HH:mm")</td>
                            <td><span class="badge bg-info text-dark">@(item.EstadoReserva?.Nombre ?? "Registrada")</span></td>
                            <td>@item.Moneda @item.MontoTotalCotizado.ToString("N2")</td>
                            <td>
                                <a asp-controller="SolicitudServicio" asp-action="Paso6ConfirmacionExitosa" asp-route-id="@item.ReservaID" class="btn btn-sm btn-primary">Ver Detalle</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>