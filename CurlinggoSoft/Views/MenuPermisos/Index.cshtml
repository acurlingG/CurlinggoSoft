@model IEnumerable<CurlinggoSoft.Models.MenuPermiso>
@{ ViewData["Title"] = "Menú Permisos"; }
<h1>Asignación de Permisos a Menús</h1>
<p><a asp-action="Create" class="btn btn-primary">+ Nueva Asignación</a></p>
<table class="table table-striped table-hover">
    <thead class="table-dark">
        <tr><th>Menú</th><th>Permiso</th><th>Acciones</th></tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.Menu?.Nombre</td>
                <td>@item.Permiso?.Nombre</td>
                <td>
                    <a asp-action="Details" asp-route-menuId="@item.MenuID" asp-route-permisoId="@item.PermisoID" class="btn btn-info btn-sm">Ver</a>
                    <a asp-action="Delete" asp-route-menuId="@item.MenuID" asp-route-permisoId="@item.PermisoID" class="btn btn-danger btn-sm">Eliminar</a>
                </td>
            </tr>
        }
    </tbody>
</table>
<div><a asp-action="Index" asp-controller="Admin" class="btn btn-secondary mt-3">← Volver al Admin</a></div>
