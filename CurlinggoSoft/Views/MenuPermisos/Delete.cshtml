@model CurlinggoSoft.Models.MenuPermiso
@{ ViewData["Title"] = "Eliminar Menú Permiso"; }
<h1>Eliminar Asignación</h1>
<div class="alert alert-warning"><h4>¿Está seguro?</h4></div>
<dl class="row">
    <dt class="col-sm-2">Menú</dt><dd class="col-sm-10">@Model.Menu?.Nombre</dd>
    <dt class="col-sm-2">Permiso</dt><dd class="col-sm-10">@Model.Permiso?.Nombre</dd>
</dl>
<form asp-action="Delete">
    <input type="hidden" name="menuId" value="@Model.MenuID" />
    <input type="hidden" name="permisoId" value="@Model.PermisoID" />
    <button type="submit" class="btn btn-danger">Eliminar</button>
    <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
</form>
