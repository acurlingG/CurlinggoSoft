@model CurlinggoSoft.Models.Notificacion
@{ ViewData["Title"] = "Detalles Notificación"; }
<h1>Detalles de Notificación</h1>
<dl class="row">
    <dt class="col-sm-2">Usuario</dt><dd class="col-sm-10">@Model.Usuario?.Email</dd>
    <dt class="col-sm-2">Tipo</dt><dd class="col-sm-10">@Model.TipoNotificacion</dd>
    <dt class="col-sm-2">Título</dt><dd class="col-sm-10">@Model.Titulo</dd>
    <dt class="col-sm-2">Mensaje</dt><dd class="col-sm-10">@Model.Mensaje</dd>
    <dt class="col-sm-2">Leída</dt><dd class="col-sm-10">@(Model.Leida ? "Sí" : "No")</dd>
    <dt class="col-sm-2">Fecha Creación</dt><dd class="col-sm-10">@Model.FechaCreacion</dd>
</dl>
<div><a asp-action="Edit" asp-route-id="@Model.NotificacionID" class="btn btn-warning">Editar</a> <a asp-action="Index" class="btn btn-secondary">Volver</a></div>
