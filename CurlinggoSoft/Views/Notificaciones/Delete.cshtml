@model CurlinggoSoft.Models.Notificacion
@{ ViewData["Title"] = "Eliminar Notificación"; }
<h1>Eliminar Notificación</h1>
<div class="alert alert-warning"><h4>¿Está seguro?</h4></div>
<dl class="row"><dt class="col-sm-2">Título</dt><dd class="col-sm-10">@Model.Titulo</dd></dl>
<form asp-action="Delete">
    <input type="hidden" asp-for="NotificacionID" />
    <button type="submit" class="btn btn-danger">Eliminar</button>
    <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
</form>
