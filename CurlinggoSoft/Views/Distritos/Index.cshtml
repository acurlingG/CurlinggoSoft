@model IEnumerable<CurlinggoSoft.Models.Distrito>
@{ ViewData["Title"] = "Distritos"; }
<h1>Distritos</h1>
<p><a asp-action="Create" class="btn btn-primary">+ Nuevo Distrito</a></p>
<table class="table table-striped table-hover">
    <thead class="table-dark">
        <tr><th>Provincia</th><th>Cantón</th><th>Nombre</th><th>Código DTA</th><th>Activo</th><th>Acciones</th></tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@Html.DisplayFor(modelItem => item.Canton.Provincia.Nombre)</td>
                <td>@Html.DisplayFor(modelItem => item.Canton.Nombre)</td>
                <td>@Html.DisplayFor(modelItem => item.Nombre)</td>
                <td>@Html.DisplayFor(modelItem => item.CodigoDTA)</td>
                <td><span class="badge @(item.Activo ? "bg-success" : "bg-danger")">@(item.Activo ? "Activo" : "Inactivo")</span></td>
                <td>
                    <a asp-action="Edit" asp-route-distritoid="@item.DistritoID" class="btn btn-warning btn-sm">Editar</a>
                    <a asp-action="Delete" asp-route-distritoid="@item.DistritoID" class="btn btn-danger btn-sm">Eliminar</a>
                </td>
            </tr>
        }
    </tbody>
</table>
<div><a asp-action="Index" asp-controller="Admin" class="btn btn-secondary mt-3">← Volver al Admin</a></div>
