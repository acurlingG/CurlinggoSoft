@model CurlinggoSoft.Models.IntentoPago
@{ ViewData["Title"] = "Editar Intento de Pago"; }
<h1>Editar Intento de Pago</h1>
<div class="row"><div class="col-md-6">
<form asp-action="Edit">
    <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
    <input type="hidden" asp-for="IntentoPagoID" />
    <input type="hidden" asp-for="FechaIntento" />
    <div class="mb-3"><label asp-for="PagoID" class="form-label"></label><select asp-for="PagoID" class="form-select" asp-items="ViewBag.PagoID"></select></div>
    <div class="mb-3"><label asp-for="MetodoPagoID" class="form-label"></label><select asp-for="MetodoPagoID" class="form-select" asp-items="ViewBag.MetodoPagoID"></select></div>
    <div class="mb-3"><label asp-for="EstadoPagoID" class="form-label"></label><select asp-for="EstadoPagoID" class="form-select" asp-items="ViewBag.EstadoPagoID"></select></div>
    <div class="mb-3"><label asp-for="MontoIntento" class="form-label"></label><input asp-for="MontoIntento" type="number" step="0.01" class="form-control" /></div>
    <div class="mb-3"><label asp-for="ReferenciaComprobante" class="form-label"></label><input asp-for="ReferenciaComprobante" class="form-control" /></div>
    <div class="mb-3"><label asp-for="ReferenciaProveedor" class="form-label"></label><input asp-for="ReferenciaProveedor" class="form-control" /></div>
    <div class="mb-3"><label asp-for="MensajeProveedor" class="form-label"></label><textarea asp-for="MensajeProveedor" class="form-control"></textarea></div>
    <div><button type="submit" class="btn btn-primary">Guardar</button> <a asp-action="Index" class="btn btn-secondary">Cancelar</a></div>
</form>
</div></div>
@section Scripts { @{await Html.RenderPartialAsync("_ValidationScriptsPartial");} }
