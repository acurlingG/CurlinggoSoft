@model CurlinggoSoft.Models.SolicitudTecnico
@{
    ViewData["Title"] = "Solicitud Enviada";
}
<div class="container py-5 text-center" style="max-width:600px;">
    <i class="fa fa-check-circle text-success" style="font-size:64px;"></i>
    <h3 class="mt-3">¡Solicitud Enviada!</h3>
    <p class="text-muted">Su código de solicitud es <strong>@Model.CodigoSolicitud</strong>.</p>
    <p>Le notificaremos por correo cuando un administrador revise su solicitud.</p>
    <a asp-controller="Home" asp-action="Index" class="btn btn-primary mt-3">Volver al Inicio</a>
</div>
