@model CurlinggoSoft.Models.Usuario
@{ ViewData["Title"] = "Eliminar Usuario"; }
<h1>Eliminar Usuario</h1>
<div class="alert alert-warning"><h4>¿Está seguro?</h4></div>
<dl class="row">
    <dt class="col-sm-2">Nombre</dt><dd class="col-sm-10">@Model.Nombre @Model.Apellidos</dd>
    <dt class="col-sm-2">Email</dt><dd class="col-sm-10">@Model.Email</dd>
</dl>
<form asp-action="Delete">
    <input type="hidden" asp-for="UsuarioID" />
    <button type="submit" class="btn btn-danger">Eliminar</button>
    <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
</form>
