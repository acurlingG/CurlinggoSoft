@model IEnumerable<CurlinggoSoft.Models.Usuario>
@{ ViewData["Title"] = "Usuarios"; }
<h1>Usuarios Registrados</h1>
<p><a asp-action="Create" class="btn btn-primary">+ Nuevo Usuario</a></p>
<table class="table table-striped table-hover">
    <thead class="table-dark">
        <tr><th>Nombre</th><th>Apellidos</th><th>Email</th><th>Teléfono</th><th>Estado</th><th>Acciones</th></tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.Nombre</td>
                <td>@item.Apellidos</td>
                <td>@item.Email</td>
                <td>@item.Telefono</td>
                <td><span class="badge bg-info">@item.EstadoUsuario</span></td>
                <td>
                    <a asp-action="Details" asp-route-id="@item.UsuarioID" class="btn btn-info btn-sm">Ver</a>
                    <a asp-action="Edit" asp-route-id="@item.UsuarioID" class="btn btn-warning btn-sm">Editar</a>
                    <a asp-action="Delete" asp-route-id="@item.UsuarioID" class="btn btn-danger btn-sm">Eliminar</a>
                </td>
            </tr>
        }
    </tbody>
</table>
<div><a asp-action="Index" asp-controller="Admin" class="btn btn-secondary mt-3">← Volver al Admin</a></div>
