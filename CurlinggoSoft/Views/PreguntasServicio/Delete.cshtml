@model CurlinggoSoft.Models.PreguntaServicio
@{ ViewData["Title"] = "Eliminar Pregunta"; }
<h1>Eliminar Pregunta de Servicio</h1>
<div class="alert alert-warning"><h4>¿Está seguro?</h4></div>
<dl class="row">
    <dt class="col-sm-2">Pregunta</dt><dd class="col-sm-10">@Model.TextoPregunta</dd>
</dl>
<form asp-action="Delete">
    <input type="hidden" asp-for="PreguntaServicioID" />
    <button type="submit" class="btn btn-danger">Eliminar</button>
    <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
</form>
