@model IEnumerable<CurlinggoSoft.Models.PreguntaServicio>
@{ ViewData["Title"] = "Preguntas Servicio"; }
<h1>Preguntas de Servicio</h1>
<p><a asp-action="Create" class="btn btn-primary">+ Nueva Pregunta</a></p>
<table class="table table-striped table-hover">
    <thead class="table-dark">
        <tr><th>Servicio</th><th>Pregunta</th><th>Tipo</th><th>Obligatoria</th><th>Orden</th><th>Acciones</th></tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.Servicio?.NombreServicio</td>
                <td>@item.TextoPregunta</td>
                <td>@item.TipoRespuesta</td>
                <td>@(item.Obligatoria ? "Sí" : "No")</td>
                <td>@item.Orden</td>
                <td>
                    <a asp-action="Details" asp-route-id="@item.PreguntaServicioID" class="btn btn-info btn-sm">Ver</a>
                    <a asp-action="Edit" asp-route-id="@item.PreguntaServicioID" class="btn btn-warning btn-sm">Editar</a>
                    <a asp-action="Delete" asp-route-id="@item.PreguntaServicioID" class="btn btn-danger btn-sm">Eliminar</a>
                </td>
            </tr>
        }
    </tbody>
</table>
<div><a asp-action="Index" asp-controller="Admin" class="btn btn-secondary mt-3">← Volver al Admin</a></div>
