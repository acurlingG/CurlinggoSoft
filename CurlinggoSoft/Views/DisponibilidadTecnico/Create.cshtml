@model CurlinggoSoft.Models.DisponibilidadTecnico
@{ ViewData["Title"] = "Crear Disponibilidad"; }
<h1>Crear Disponibilidad de Técnico</h1>
<div class="row">
    <div class="col-md-6">
        <form asp-action="Create">
            <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
            <div class="mb-3">
                <label asp-for="TecnicoID" class="form-label"></label>
                <select asp-for="TecnicoID" class="form-select" asp-items="ViewBag.TecnicoID"></select>
                <span asp-validation-for="TecnicoID" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="DiaSemana" class="form-label"></label>
                <input asp-for="DiaSemana" type="number" min="1" max="7" class="form-control" />
                <span asp-validation-for="DiaSemana" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="HoraInicio" class="form-label"></label>
                <input asp-for="HoraInicio" type="time" class="form-control" />
                <span asp-validation-for="HoraInicio" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="HoraFin" class="form-label"></label>
                <input asp-for="HoraFin" type="time" class="form-control" />
                <span asp-validation-for="HoraFin" class="text-danger"></span>
            </div>
            <div class="form-check mb-3">
                <input type="hidden" name="Activa" value="false" />
                <input asp-for="Activa" type="checkbox" class="form-check-input" />
                <label class="form-check-label" for="Activa">Activa</label>
            </div>
            <div><button type="submit" class="btn btn-primary">Guardar</button> <a asp-action="Index" class="btn btn-secondary">Cancelar</a></div>
        </form>
    </div>
</div>
@section Scripts { @{await Html.RenderPartialAsync("_ValidationScriptsPartial");} }
