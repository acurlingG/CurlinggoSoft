@model IEnumerable<CurlinggoSoft.Models.DisponibilidadTecnico>
@{
    ViewData["Title"] = "Disponibilidad Técnico";

    // Mapeo DiaSemana (byte 1=Lun...7=Dom, según validación del modelo) a
    // nombre en español para mostrar en la tabla en vez del número crudo.
    string NombreDia(byte dia) => dia switch
    {
        1 => "Lunes",
        2 => "Martes",
        3 => "Miércoles",
        4 => "Jueves",
        5 => "Viernes",
        6 => "Sábado",
        7 => "Domingo",
        _ => "Desconocido"
    };
}
<h1>Disponibilidad de Técnicos</h1>
<p><a asp-action="Create" class="btn btn-primary">+ Nueva Disponibilidad</a></p>

<form method="get" asp-action="Index" class="row g-2 mb-3">
    <div class="col-auto">
        <select name="tecnicoId" class="form-select" onchange="this.form.submit()">
            <option value="">-- Todos los técnicos --</option>
            @foreach (var item in (Microsoft.AspNetCore.Mvc.Rendering.SelectList)ViewBag.Tecnicos)
            {
                <option value="@item.Value" selected="@(item.Value == (string)ViewBag.TecnicoIDSeleccionado)">@item.Text</option>
            }
        </select>
    </div>
    <div class="col-auto">
        <button type="submit" class="btn btn-outline-secondary">Filtrar</button>
        <a asp-action="Index" class="btn btn-outline-secondary">Limpiar</a>
    </div>
</form>

<table class="table table-striped table-hover">
    <thead class="table-dark">
        <tr><th>Técnico</th><th>Día</th><th>Hora Inicio</th><th>Hora Fin</th><th>Activa</th><th>Acciones</th></tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.Tecnico?.IdentificacionCedula</td>
                <td>@NombreDia(item.DiaSemana)</td>
                <td>@item.HoraInicio</td>
                <td>@item.HoraFin</td>
                <td><span class="badge @(item.Activa ? "bg-success" : "bg-danger")">@(item.Activa ? "Activa" : "Inactiva")</span></td>
                <td>
                    <a asp-action="Details" asp-route-id="@item.DisponibilidadID" class="btn btn-info btn-sm">Ver</a>
                    <a asp-action="Edit" asp-route-id="@item.DisponibilidadID" class="btn btn-warning btn-sm">Editar</a>
                    <a asp-action="Delete" asp-route-id="@item.DisponibilidadID" class="btn btn-danger btn-sm">Eliminar</a>
                </td>
            </tr>
        }
    </tbody>
</table>
<div><a asp-action="Index" asp-controller="Admin" class="btn btn-secondary mt-3">← Volver al Admin</a></div>
