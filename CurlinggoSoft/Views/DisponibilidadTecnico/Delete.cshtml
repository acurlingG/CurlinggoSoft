@model CurlinggoSoft.Models.DisponibilidadTecnico
@{ ViewData["Title"] = "Eliminar Disponibilidad"; }
<h1>Eliminar Disponibilidad</h1>
<div class="alert alert-warning"><h4>¿Está seguro?</h4></div>
<dl class="row">
    <dt class="col-sm-2">Técnico</dt><dd class="col-sm-10">@Model.Tecnico?.IdentificacionCedula</dd>
    <dt class="col-sm-2">Día</dt><dd class="col-sm-10">@Model.DiaSemana</dd>
</dl>
<form asp-action="Delete">
    <input type="hidden" asp-for="DisponibilidadID" />
    <button type="submit" class="btn btn-danger">Eliminar</button>
    <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
</form>
