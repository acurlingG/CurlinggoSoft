@* Menú principal - usado en _AdminLayout (Admin) y como sección extra en _Layout (Cliente/Tecnico) *@
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/4.7.0/css/font-awesome.min.css">

<div class="navbar-custom mb-3">
    <div class="navbar-custom-left">
        <!-- Home / Inicio común -->
        <a asp-controller="Home" asp-action="Index"><i class="fa fa-home"></i> Inicio</a>

        @if (User.IsInRole("Admin"))
        {
            <!-- 1. Catálogo Geográfico -->
            <div class="dropdown-custom">
                <button class="dropbtn" onclick="toggleMenu('geoDropdown')">
                    <i class="fa fa-map-marker"></i> Geografía <i class="fa fa-caret-down"></i>
                </button>
                <div class="dropdown-content" id="geoDropdown">
                    <a asp-controller="Provincias" asp-action="Index">Provincias</a>
                    <a asp-controller="Cantones" asp-action="Index">Cantones</a>
                    <a asp-controller="Distritos" asp-action="Index">Distritos</a>
                </div>
            </div>

            <!-- 2. Catálogo de Servicios -->
            <div class="dropdown-custom">
                <button class="dropbtn" onclick="toggleMenu('serviciosDropdown')">
                    <i class="fa fa-wrench"></i> Catálogo Servicios <i class="fa fa-caret-down"></i>
                </button>
                <div class="dropdown-content" id="serviciosDropdown">
                    <a asp-controller="CategoriasServicio" asp-action="Index">Categorías</a>
                    <a asp-controller="SubcategoriasServicio" asp-action="Index">Subcategorías</a>
                    <a asp-controller="Servicios" asp-action="Index">Servicios Base</a>
                    <a asp-controller="TecnicoEspecialidades" asp-action="Index">Especialidades Técnicas</a>
                    <a asp-controller="PreguntasServicio" asp-action="Index">Preguntas de Servicio</a>
                    <a asp-controller="OpcionesPregunta" asp-action="Index">Opciones de Pregunta</a>
                </div>
            </div>

            <!-- 3. Parámetros del Sistema -->
            <div class="dropdown-custom">
                <button class="dropbtn" onclick="toggleMenu('parametrosDropdown')">
                    <i class="fa fa-cogs"></i> Parámetros <i class="fa fa-caret-down"></i>
                </button>
                <div class="dropdown-content" id="parametrosDropdown">
                    <a asp-controller="MetodosPago" asp-action="Index">Métodos de Pago</a>
                    <a asp-controller="EstadosReserva" asp-action="Index">Estados de Reserva</a>
                    <a asp-controller="EstadosPago" asp-action="Index">Estados de Pago</a>
                    <a asp-controller="EstadosOfertaTecnico" asp-action="Index">Estados de Oferta</a>
                    <a asp-controller="TiposEvaluacion" asp-action="Index">Tipos de Evaluación</a>
                </div>
            </div>

            <!-- 4. Seguridad y Usuarios -->
            <div class="dropdown-custom">
                <button class="dropbtn" onclick="toggleMenu('seguridadDropdown')">
                    <i class="fa fa-users"></i> Seguridad <i class="fa fa-caret-down"></i>
                </button>
                <div class="dropdown-content" id="seguridadDropdown">
                    <a asp-controller="Usuarios" asp-action="Index">Usuarios Registrados</a>
                    <a asp-controller="ClientesPerfil" asp-action="Index">Perfiles de Clientes</a>
                    <a asp-controller="TecnicosPerfil" asp-action="Index">Perfiles Técnicos</a>
                    <a asp-controller="DireccionesCliente" asp-action="Index">Direcciones de Cliente</a>
                    <a asp-controller="DisponibilidadTecnico" asp-action="Index">Disponibilidad Técnica</a>
                    <a asp-controller="Menus" asp-action="Index">Estructura de Menús</a>
                    <a asp-controller="Permisos" asp-action="Index">Permisos del Sistema</a>
                    <a asp-controller="MenuPermisos" asp-action="Index">Menú-Permisos</a>
                </div>
            </div>

            <!-- 5. Reservas -->
            <div class="dropdown-custom">
                <button class="dropbtn" onclick="toggleMenu('reservasDropdown')">
                    <i class="fa fa-calendar"></i> Reservas <i class="fa fa-caret-down"></i>
                </button>
                <div class="dropdown-content" id="reservasDropdown">
                    <a asp-controller="SolicitudesReserva" asp-action="Index">Solicitudes de Reserva</a>
                    <a asp-controller="HistorialEstadosReserva" asp-action="Index">Historial de Estados</a>
                    <a asp-controller="OfertasTecnico" asp-action="Index">Ofertas a Técnicos</a>
                    <a asp-controller="RespuestasReserva" asp-action="Index">Respuestas de Reserva</a>
                    <a asp-controller="RespuestasReservaOpciones" asp-action="Index">Respuestas Opción Múltiple</a>
                    <a asp-controller="DetallesPrecioReserva" asp-action="Index">Detalle de Precio</a>
                    <a asp-controller="Notificaciones" asp-action="Index">Notificaciones</a>
                </div>
            </div>

            <!-- 6. Pagos -->
            <div class="dropdown-custom">
                <button class="dropbtn" onclick="toggleMenu('pagosDropdown')">
                    <i class="fa fa-money"></i> Pagos <i class="fa fa-caret-down"></i>
                </button>
                <div class="dropdown-content" id="pagosDropdown">
                    <a asp-controller="Pagos" asp-action="Index">Pagos</a>
                    <a asp-controller="IntentosPago" asp-action="Index">Intentos de Pago</a>
                </div>
            </div>

            <!-- 7. Evaluaciones y Auditoría -->
            <div class="dropdown-custom">
                <button class="dropbtn" onclick="toggleMenu('auditoriaDropdown')">
                    <i class="fa fa-clipboard"></i> Auditoría <i class="fa fa-caret-down"></i>
                </button>
                <div class="dropdown-content" id="auditoriaDropdown">
                    <a asp-controller="Evaluaciones" asp-action="Index">Evaluaciones</a>
                    <a asp-controller="Auditoria" asp-action="Index">Auditoría</a>
                    <a asp-controller="LogsIntervencionOperativa" asp-action="Index">Logs de Intervención</a>
                </div>
            </div>
        }

        @if (User.IsInRole("Cliente"))
        {
            <a asp-controller="Cliente" asp-action="Index"><i class="fa fa-dashboard"></i> Mi Dashboard</a>
            <a asp-controller="SolicitudServicio" asp-action="Paso1Servicio"><i class="fa fa-plus-circle"></i> Solicitar Servicio</a>
            <a asp-controller="Cliente" asp-action="MisReservas"><i class="fa fa-calendar"></i> Mis Reservas</a>
            <a asp-controller="Cliente" asp-action="MisDirecciones"><i class="fa fa-map-marker"></i> Mis Direcciones</a>
            <a asp-controller="Servicios" asp-action="Index"><i class="fa fa-wrench"></i> Catálogo de Servicios</a>
        }

        @if (User.IsInRole("Tecnico"))
        {
            <a asp-controller="Tecnico" asp-action="Index"><i class="fa fa-dashboard"></i> Mi Panel</a>
            <a asp-controller="Tecnico" asp-action="OfertasDisponibles"><i class="fa fa-list"></i> Ofertas de Servicio</a>
            <a asp-controller="DisponibilidadTecnico" asp-action="Index"><i class="fa fa-clock-o"></i> Mi Disponibilidad</a>
        }
    </div>

    <div class="navbar-custom-right">
        @if (User.Identity != null && User.Identity.IsAuthenticated)
        {
            <span class="admin-user-greeting"><i class="fa fa-user-circle"></i> Hola, @User.Identity.Name</span>
            <form asp-controller="Account" asp-action="Logout" method="post">
                <button type="submit" class="btn-logout"><i class="fa fa-sign-out"></i> Cerrar sesión</button>
            </form>
        }
    </div>
</div>

<script>
    /* Alterna la apertura del menú seleccionado y cierra los demás */
    function toggleMenu(menuId) {
        var dropdowns = document.getElementsByClassName("dropdown-content");
        for (var i = 0; i < dropdowns.length; i++) {
            if (dropdowns[i].id !== menuId) {
                dropdowns[i].classList.remove("show");
            }
        }
        document.getElementById(menuId).classList.toggle("show");
    }

    /* Cierra cualquier dropdown abierto si el usuario hace clic fuera de los botones */
    window.onclick = function(e) {
        if (!e.target.matches('.dropbtn')) {
            var dropdowns = document.getElementsByClassName("dropdown-content");
            for (var i = 0; i < dropdowns.length; i++) {
                var openDropdown = dropdowns[i];
                if (openDropdown.classList.contains('show')) {
                    openDropdown.classList.remove('show');
                }
            }
        }
    }
</script>