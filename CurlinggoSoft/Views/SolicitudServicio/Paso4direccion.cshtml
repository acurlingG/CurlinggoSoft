@model object
@{
    ViewData["Title"] = "Solicitar Servicio - Paso 4";
    var provincias = ViewBag.Provincias as List<CurlinggoSoft.Models.Provincia> ?? new List<CurlinggoSoft.Models.Provincia>();
}

<link rel="stylesheet" href="~/css/wizard-servicio.css" />
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" />

<div class="wizard-container">

    <!-- Encabezado tipo app CURLINGgo -->
    <div class="wizard-header">
        <span class="brand"><span class="brand-curling">CURLING</span><span class="brand-go">go</span></span>
    </div>

    <!-- Indicador de pasos (4 de 5) -->
    <div class="step-indicator">
        <div class="step done"><span><i class="bi bi-check-lg"></i></span><small>Servicio</small></div>
        <div class="step-line done"></div>
        <div class="step done"><span><i class="bi bi-check-lg"></i></span><small>Detalle</small></div>
        <div class="step-line done"></div>
        <div class="step done"><span><i class="bi bi-check-lg"></i></span><small>Horario</small></div>
        <div class="step-line done"></div>
        <div class="step active"><span>4</span><small>Dirección</small></div>
        <div class="step-line"></div>
        <div class="step"><span>5</span><small>Pago</small></div>
    </div>

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">@TempData["Error"]</div>
    }

    <h5 class="wizard-question">¿Dónde te brindamos el servicio?</h5>

    <p class="text-muted small" id="estadoUbicacion">
        <i class="bi bi-geo-alt"></i> Detectando tu ubicación para asignarte un técnico cercano...
    </p>

    <form asp-action="SeleccionarDireccion" method="post" id="formDireccion" class="direccion-form">
        @Html.AntiForgeryToken()

        <!-- Coordenadas capturadas por JS al cargar la página (ver Scripts abajo).
             Pueden quedar vacías si el navegador no soporta geolocalización o si
             el cliente niega el permiso — el formulario NO se bloquea por eso,
             ver la nota de contingencia en el controlador. -->
        <input type="hidden" id="latitud" name="latitud" />
        <input type="hidden" id="longitud" name="longitud" />

        <div class="campo">
            <label for="provinciaSelect">Provincia</label>
            <select id="provinciaSelect" name="provinciaId" class="form-select" required>
                <option value="">-- Selecciona --</option>
                @foreach (var p in provincias)
                {
                    <option value="@p.ProvinciaID">@p.Nombre</option>
                }
            </select>
        </div>

        <div class="campo">
            <label for="cantonSelect">Cantón</label>
            <select id="cantonSelect" name="cantonId" class="form-select" required disabled>
                <option value="">-- Selecciona primero la provincia --</option>
            </select>
        </div>

        <div class="campo">
            <label for="distritoSelect">Distrito</label>
            <select id="distritoSelect" name="distritoId" class="form-select" required disabled>
                <option value="">-- Selecciona primero el cantón --</option>
            </select>
        </div>

        <div class="campo">
            <label for="direccionExacta">Dirección exacta (con referencias)</label>
            <textarea id="direccionExacta" name="direccionExacta" class="form-control" rows="2"
                      placeholder="Ej: 200m norte de la iglesia, casa portón negro" required></textarea>
        </div>

        <div class="campo">
            <label for="nombreContacto">Nombre de contacto</label>
            <input type="text" id="nombreContacto" name="nombreContacto" class="form-control" required />
        </div>

        <div class="campo">
            <label for="whatsapp">WhatsApp</label>
            <input type="tel" id="whatsapp" name="whatsapp" class="form-control"
                   placeholder="Ej: 8888-8888" required />
        </div>

        <button type="submit" class="btn-continuar w-100 mt-2">Continuar</button>
    </form>

    <div class="wizard-nav">
        <a asp-action="Paso3Calendario" class="link-volver">
            <i class="bi bi-arrow-left"></i> Regresar
        </a>
    </div>

</div>

@section Scripts {
    <script>
        // --- Captura de ubicación al cargar el Paso 4 ---
        // Si el navegador no soporta geolocalización, si el cliente niega el
        // permiso, o si se agota el tiempo de espera, los campos "latitud"/
        // "longitud" quedan vacíos y el formulario se puede enviar igual. El
        // fallback de qué hacer sin coordenadas se maneja en el servidor
        // (ConfirmarYPagar), no aquí.
        //
        // IMPORTANTE: capturarUbicacion() es asíncrona y puede tardar varios
        // segundos en resolver. Si el usuario le daba "Continuar" antes de que
        // terminara, el submit se enviaba con latitud/longitud vacíos aunque
        // el GPS sí estuviera disponible unos instantes después. Por eso el
        // formulario ahora espera la promesa de ubicación (con un tope
        // máximo) antes de enviarse.
        const estadoUbicacion = document.getElementById('estadoUbicacion');
        const inputLat = document.getElementById('latitud');
        const inputLon = document.getElementById('longitud');
        const formDireccion = document.getElementById('formDireccion');

        let ubicacionLista = false;

        function capturarUbicacion() {
            return new Promise(function (resolve) {
                if (!navigator.geolocation) {
                    estadoUbicacion.innerHTML = '<i class="bi bi-geo-alt text-warning"></i> Tu navegador no soporta geolocalización. Buscaremos un técnico por tu zona general.';
                    ubicacionLista = true;
                    resolve();
                    return;
                }

                navigator.geolocation.getCurrentPosition(
                    function (position) {
                        inputLat.value = position.coords.latitude;
                        inputLon.value = position.coords.longitude;
                        estadoUbicacion.innerHTML = '<i class="bi bi-geo-alt-fill text-success"></i> Ubicación detectada. Te asignaremos un técnico cercano.';
                        ubicacionLista = true;
                        resolve();
                    },
                    function () {
                        estadoUbicacion.innerHTML = '<i class="bi bi-geo-alt text-warning"></i> No se pudo obtener tu ubicación exacta. Buscaremos un técnico por tu zona general.';
                        ubicacionLista = true;
                        resolve();
                    },
                    { enableHighAccuracy: true, timeout: 8000, maximumAge: 0 }
                );
            });
        }

        const promesaUbicacion = capturarUbicacion();

        // Si el usuario envía el formulario antes de que la geolocalización
        // termine, esperamos la promesa (con su propio tope de 8s) antes de
        // continuar, en vez de dejarlo ir con latitud/longitud vacíos.
        if (formDireccion) {
            formDireccion.addEventListener('submit', function (evt) {
                if (ubicacionLista) {
                    return; // ya hay resultado (con o sin coordenadas), enviar normal
                }

                evt.preventDefault();
                const submitBtn = formDireccion.querySelector('button[type="submit"]');
                if (submitBtn) {
                    submitBtn.disabled = true;
                    submitBtn.textContent = 'Ubicando...';
                }

                promesaUbicacion.finally(function () {
                    if (submitBtn) {
                        submitBtn.disabled = false;
                        submitBtn.textContent = 'Continuar';
                    }
                    formDireccion.submit();
                });
            });
        }

        const cantonSelect = document.getElementById('cantonSelect');
        const distritoSelect = document.getElementById('distritoSelect');

        document.getElementById('provinciaSelect').addEventListener('change', async function() {
            const provinciaId = this.value;

            cantonSelect.innerHTML = '<option value="">Cargando...</option>';
            cantonSelect.disabled = true;
            distritoSelect.innerHTML = '<option value="">-- Selecciona primero el cantón --</option>';
            distritoSelect.disabled = true;

            if (!provinciaId) {
                cantonSelect.innerHTML = '<option value="">-- Selecciona primero la provincia --</option>';
                return;
            }

            const resp = await fetch(`/SolicitudServicio/GetCantones?provinciaId=${provinciaId}`);
            const cantones = await resp.json();

            cantonSelect.innerHTML = '<option value="">-- Selecciona --</option>';
            cantones.forEach(c => {
                const opt = document.createElement('option');
                opt.value = c.id;
                opt.textContent = c.nombre;
                cantonSelect.appendChild(opt);
            });
            cantonSelect.disabled = false;
        });

        cantonSelect.addEventListener('change', async function() {
            const cantonId = this.value;

            distritoSelect.innerHTML = '<option value="">Cargando...</option>';
            distritoSelect.disabled = true;

            if (!cantonId) {
                distritoSelect.innerHTML = '<option value="">-- Selecciona primero el cantón --</option>';
                return;
            }

            const resp = await fetch(`/SolicitudServicio/GetDistritos?cantonId=${cantonId}`);
            const distritos = await resp.json();

            distritoSelect.innerHTML = '<option value="">-- Selecciona --</option>';
            distritos.forEach(d => {
                const opt = document.createElement('option');
                opt.value = d.id;
                opt.textContent = d.nombre;
                distritoSelect.appendChild(opt);
            });
            distritoSelect.disabled = false;
        });
    </script>
}
