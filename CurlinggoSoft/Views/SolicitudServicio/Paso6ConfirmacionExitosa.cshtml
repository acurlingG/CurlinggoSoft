@model CurlinggoSoft.Models.SolicitudReserva
@{
    ViewData["Title"] = "¡Cita Confirmada!";
    var numeroOrden = Model.ReservaID.ToString("D4");
}

<link rel="stylesheet" href="~/css/wizard-servicio.css" />
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" />

<div class="wizard-container">

    <!-- Encabezado -->
    <div class="wizard-header">
        <span class="brand"><span class="brand-curling">CURLING</span><span class="brand-go">go</span></span>
    </div>

    <div class="confirmacion-wrapper text-center">
        <h2 class="confirmacion-titulo">¡Cita Confirmada!</h2>
        <p class="orden-numero">Orden #CR-@numeroOrden</p>

        <div class="status-box">
            <span class="status-label">Current Status</span>
            <h4 class="status-texto">Buscando Técnico...</h4>
        </div>

        <!-- Mascota / Mensaje de confirmación -->
        <div class="mascota-confirmacion mt-4">
            <img src="~/images/nano-banana.png" alt="Nano" onerror="this.style.display='none'" />
            <div class="bubble-confirmacion">
                ¡Técnico asignado!<br />
                Revisa tu WhatsApp para la confirmación.
            </div>
        </div>

        <!-- Barra de progreso / Tracking -->
        <div class="tracking-box mt-4">
            <span class="tracking-label">Live Tracking...</span>
            <div class="progress tracking-bar">
                <div class="progress-bar progress-bar-striped progress-bar-animated bg-primary" 
                     role="progressbar" style="width: 35%" aria-valuenow="35" aria-valuemin="0" aria-valuemax="100"></div>
            </div>
        </div>

        <a href="@Url.Action("Index", "Home")" class="btn-continuar w-100 mt-5 text-decoration-none text-center d-block">
            Volver al Inicio
        </a>
    </div>

</div>