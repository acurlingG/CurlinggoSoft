@model IEnumerable<CurlinggoSoft.Models.TecnicoUbicacionActual>
@{ ViewData["Title"] = "Ubicación Actual de Técnicos"; }
<h1>Ubicación Actual de Técnicos</h1>
<p><a asp-action="Create" class="btn btn-primary">+ Nueva Ubicación</a></p>
<table class="table table-striped table-hover">
    <thead class="table-dark"><tr><th>Técnico</th><th>Latitud</th><th>Longitud</th><th>Actualizado</th><th>Acciones</th></tr></thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.Tecnico?.IdentificacionCedula</td>
                <td>@item.Latitud</td>
                <td>@item.Longitud</td>
                <td>@item.FechaActualizacion</td>
                <td>
                    <a asp-action="Details" asp-route-id="@item.TecnicoID" class="btn btn-info btn-sm">Ver</a>
                    <a asp-action="Edit" asp-route-id="@item.TecnicoID" class="btn btn-warning btn-sm">Editar</a>
                    <a asp-action="Delete" asp-route-id="@item.TecnicoID" class="btn btn-danger btn-sm">Eliminar</a>
                </td>
            </tr>
        }
    </tbody>
</table>
<div><a asp-action="Index" asp-controller="Admin" class="btn btn-secondary mt-3">← Volver al Admin</a></div>
