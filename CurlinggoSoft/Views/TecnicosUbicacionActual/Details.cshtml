@model CurlinggoSoft.Models.TecnicoUbicacionActual
@{ ViewData["Title"] = "Detalles"; }
<h1>Detalles de Ubicación de Técnico</h1>
<dl class="row">
    <dt class="col-sm-2">Técnico</dt><dd class="col-sm-10">@Model.Tecnico?.IdentificacionCedula</dd>
    <dt class="col-sm-2">Latitud</dt><dd class="col-sm-10">@Model.Latitud</dd>
    <dt class="col-sm-2">Longitud</dt><dd class="col-sm-10">@Model.Longitud</dd>
    <dt class="col-sm-2">Actualizado</dt><dd class="col-sm-10">@Model.FechaActualizacion</dd>
</dl>
<div><a asp-action="Edit" asp-route-id="@Model.TecnicoID" class="btn btn-warning">Editar</a> <a asp-action="Index" class="btn btn-secondary">Volver</a></div>
