@model IEnumerable<CurlinggoSoft.Models.ClientePerfil>
@{ ViewData["Title"] = "Clientes Perfil"; }
<h1>Perfiles de Clientes</h1>
<p><a asp-action="Create" class="btn btn-primary">+ Nuevo Perfil Cliente</a></p>
<table class="table table-striped table-hover">
    <thead class="table-dark">
        <tr><th>Cliente</th><th>Provincia</th><th>Cantón</th><th>Distrito</th><th>Dirección</th><th>Acciones</th></tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.ClienteID</td>
                <td>@item.Provincia?.Nombre</td>
                <td>@item.Canton?.Nombre</td>
                <td>@item.Distrito?.Nombre</td>
                <td>@item.DireccionExacta</td>
                <td>
                    <a asp-action="Details" asp-route-id="@item.ClienteID" class="btn btn-info btn-sm">Ver</a>
                    <a asp-action="Edit" asp-route-id="@item.ClienteID" class="btn btn-warning btn-sm">Editar</a>
                    <a asp-action="Delete" asp-route-id="@item.ClienteID" class="btn btn-danger btn-sm">Eliminar</a>
                </td>
            </tr>
        }
    </tbody>
</table>
<div><a asp-action="Index" asp-controller="Admin" class="btn btn-secondary mt-3">← Volver al Admin</a></div>
