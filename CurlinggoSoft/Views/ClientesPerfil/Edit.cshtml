@model CurlinggoSoft.Models.ClientePerfil
@{ ViewData["Title"] = "Editar Cliente Perfil"; }
<h1>Editar Perfil de Cliente</h1>
<div class="row">
    <div class="col-md-6">
        <form asp-action="Edit">
            <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
            <input type="hidden" asp-for="ClienteID" />
            <div class="mb-3">
                <label asp-for="ProvinciaID" class="form-label"></label>
                <select asp-for="ProvinciaID" class="form-select" asp-items="ViewBag.ProvinciaID"></select>
            </div>
            <div class="mb-3">
                <label asp-for="CantonID" class="form-label"></label>
                <select asp-for="CantonID" class="form-select" asp-items="ViewBag.CantonID"></select>
            </div>
            <div class="mb-3">
                <label asp-for="DistritoID" class="form-label"></label>
                <select asp-for="DistritoID" class="form-select" asp-items="ViewBag.DistritoID"></select>
            </div>
            <div class="mb-3">
                <label asp-for="DireccionExacta" class="form-label"></label>
                <input asp-for="DireccionExacta" class="form-control" />
            </div>
            <div class="mb-3">
                <label asp-for="Latitud" class="form-label"></label>
                <input asp-for="Latitud" type="number" step="0.000001" class="form-control" />
            </div>
            <div class="mb-3">
                <label asp-for="Longitud" class="form-label"></label>
                <input asp-for="Longitud" type="number" step="0.000001" class="form-control" />
            </div>
            <div><button type="submit" class="btn btn-primary">Guardar</button> <a asp-action="Index" class="btn btn-secondary">Cancelar</a></div>
        </form>
    </div>
</div>
@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    <script>
        var cantonActual = @Html.Raw(Model.CantonID);
        var distritoActual = @Html.Raw(Model.DistritoID);

        function cargarCantones(provinciaId, cantonSeleccionado) {
            var $canton = $('#CantonID');
            $canton.empty().append('<option value="">-- Seleccione --</option>');
            if (!provinciaId) { return; }
            $.getJSON('/Cantones/PorProvincia', { provinciaId: provinciaId }, function (data) {
                $.each(data, function (i, item) {
                    $canton.append($('<option></option>').val(item.cantonID).text(item.nombre));
                });
                if (cantonSeleccionado) { $canton.val(cantonSeleccionado); }
            });
        }

        function cargarDistritos(cantonId, distritoSeleccionado) {
            var $distrito = $('#DistritoID');
            $distrito.empty().append('<option value="">-- Seleccione --</option>');
            if (!cantonId) { return; }
            $.getJSON('/Distritos/PorCanton', { cantonId: cantonId }, function (data) {
                $.each(data, function (i, item) {
                    $distrito.append($('<option></option>').val(item.distritoID).text(item.nombre));
                });
                if (distritoSeleccionado) { $distrito.val(distritoSeleccionado); }
            });
        }

        $(document).ready(function () {
            cargarCantones($('#ProvinciaID').val(), cantonActual);
            cargarDistritos(cantonActual, distritoActual);

            $('#ProvinciaID').change(function () {
                cargarCantones($(this).val());
                $('#DistritoID').empty().append('<option value="">-- Seleccione --</option>');
            });
            $('#CantonID').change(function () {
                cargarDistritos($(this).val());
            });
        });
    </script>
}
