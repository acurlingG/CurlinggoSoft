@model IEnumerable<CurlinggoSoft.Models.DetallePrecioReserva>
@{ ViewData["Title"] = "Detalle de Precio de Reservas"; }
<h1>Detalle de Precio de Reservas</h1>
<p><a asp-action="Create" class="btn btn-primary">+ Nuevo Detalle</a></p>
<table class="table table-striped table-hover">
    <thead class="table-dark"><tr><th>Reserva</th><th>Concepto</th><th>Monto</th><th>Opción</th><th>Fecha</th><th>Acciones</th></tr></thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.Reserva?.ReservaID</td>
                <td>@item.Concepto</td>
                <td>@item.Monto</td>
                <td>@item.Opcion?.TextoOpcion</td>
                <td>@item.FechaRegistro</td>
                <td>
                    <a asp-action="Details" asp-route-id="@item.DetallePrecioReservaID" class="btn btn-info btn-sm">Ver</a>
                    <a asp-action="Edit" asp-route-id="@item.DetallePrecioReservaID" class="btn btn-warning btn-sm">Editar</a>
                    <a asp-action="Delete" asp-route-id="@item.DetallePrecioReservaID" class="btn btn-danger btn-sm">Eliminar</a>
                </td>
            </tr>
        }
    </tbody>
</table>
<div><a asp-action="Index" asp-controller="Admin" class="btn btn-secondary mt-3">← Volver al Admin</a></div>
