@model CurlinggoSoft.Models.Menu
@{ ViewData["Title"] = "Crear Menú"; }
<h1>Crear Menú</h1>
<div class="row">
    <div class="col-md-6">
        <form asp-action="Create">
            <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
            <div class="mb-3">
                <label asp-for="Nombre" class="form-label"></label>
                <input asp-for="Nombre" class="form-control" />
                <span asp-validation-for="Nombre" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="MenuPadreID" class="form-label"></label>
                <select asp-for="MenuPadreID" class="form-select" asp-items="ViewBag.MenuPadreID"><option value="">-- Ninguno --</option></select>
            </div>
            <div class="mb-3">
                <label asp-for="Url" class="form-label"></label>
                <input asp-for="Url" class="form-control" />
            </div>
            <div class="mb-3">
                <label asp-for="Icono" class="form-label"></label>
                <input asp-for="Icono" class="form-control" />
            </div>
            <div class="mb-3">
                <label asp-for="Orden" class="form-label"></label>
                <input asp-for="Orden" type="number" class="form-control" />
            </div>
            <div class="form-check mb-3">
                <input type="hidden" name="Activo" value="false" />
                <input asp-for="Activo" type="checkbox" class="form-check-input" />
                <label class="form-check-label" for="Activo">Activo</label>
            </div>
            <div><button type="submit" class="btn btn-primary">Guardar</button> <a asp-action="Index" class="btn btn-secondary">Cancelar</a></div>
        </form>
    </div>
</div>
@section Scripts { @{await Html.RenderPartialAsync("_ValidationScriptsPartial");} }
