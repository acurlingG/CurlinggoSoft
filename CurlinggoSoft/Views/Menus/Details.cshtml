@model CurlinggoSoft.Models.Menu
@{ ViewData["Title"] = "Detalles Menú"; }
<h1>Detalles del Menú</h1>
<dl class="row">
    <dt class="col-sm-2">Nombre</dt><dd class="col-sm-10">@Model.Nombre</dd>
    <dt class="col-sm-2">Padre</dt><dd class="col-sm-10">@Model.MenuPadre?.Nombre</dd>
    <dt class="col-sm-2">Url</dt><dd class="col-sm-10">@Model.Url</dd>
    <dt class="col-sm-2">Orden</dt><dd class="col-sm-10">@Model.Orden</dd>
</dl>
<div>
    <a asp-action="Edit" asp-route-id="@Model.MenuID" class="btn btn-warning">Editar</a>
    <a asp-action="Index" class="btn btn-secondary">Volver</a>
</div>
