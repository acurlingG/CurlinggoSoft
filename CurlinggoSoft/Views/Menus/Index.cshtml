@model IEnumerable<CurlinggoSoft.Models.Menu>
@{ ViewData["Title"] = "Menús"; }
<h1>Estructura de Menús</h1>
<p><a asp-action="Create" class="btn btn-primary">+ Nuevo Menú</a></p>
<table class="table table-striped table-hover">
    <thead class="table-dark">
        <tr><th>Nombre</th><th>Padre</th><th>Url</th><th>Orden</th><th>Activo</th><th>Acciones</th></tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.Nombre</td>
                <td>@item.MenuPadre?.Nombre</td>
                <td>@item.Url</td>
                <td>@item.Orden</td>
                <td><span class="badge @(item.Activo ? "bg-success" : "bg-danger")">@(item.Activo ? "Activo" : "Inactivo")</span></td>
                <td>
                    <a asp-action="Details" asp-route-id="@item.MenuID" class="btn btn-info btn-sm">Ver</a>
                    <a asp-action="Edit" asp-route-id="@item.MenuID" class="btn btn-warning btn-sm">Editar</a>
                    <a asp-action="Delete" asp-route-id="@item.MenuID" class="btn btn-danger btn-sm">Eliminar</a>
                </td>
            </tr>
        }
    </tbody>
</table>
<div><a asp-action="Index" asp-controller="Admin" class="btn btn-secondary mt-3">← Volver al Admin</a></div>
