@model CurlinggoSoft.Models.Servicio
@{ ViewData["Title"] = "Detalles"; }
<h1>Detalles de Servicio</h1>
<div><h4>CurlinggoSoft.Models.Servicio</h4><hr />
    <dl class="row">
        <dt class="col-sm-2">Categoría</dt>
        <dd class="col-sm-10">@Html.DisplayFor(model => model.Categoria.NombreCategoria)</dd>
        <dt class="col-sm-2">Subcategoría</dt>
        <dd class="col-sm-10">@Html.DisplayFor(model => model.Subcategoria.NombreSubcategoria)</dd>
        <dt class="col-sm-2">Nombre</dt>
        <dd class="col-sm-10">@Html.DisplayFor(model => model.NombreServicio)</dd>
        <dt class="col-sm-2">Descripción</dt>
        <dd class="col-sm-10">@Html.DisplayFor(model => model.Descripcion)</dd>
        <dt class="col-sm-2">Tarifa</dt>
        <dd class="col-sm-10">@Model.TarifaDiagnosticoBase @Model.Moneda</dd>
        <dt class="col-sm-2">Tiempo</dt>
        <dd class="col-sm-10">@Model.TiempoEstimadoMinutos minutos</dd>
    </dl>
</div>
<div><a asp-action="Edit" asp-route-id="@Model.ServicioID" class="btn btn-warning">Editar</a> <a asp-action="Index" class="btn btn-secondary">Volver</a></div>
