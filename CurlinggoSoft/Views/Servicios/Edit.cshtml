@model CurlinggoSoft.Models.Servicio
@{ ViewData["Title"] = "Editar Servicio"; }
<h1>Editar Servicio</h1>
<div class="row">
    <div class="col-md-6">
        <form asp-action="Edit">
            <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
            <input type="hidden" asp-for="ServicioID" />
            <div class="mb-3">
                <label asp-for="CategoriaID" class="form-label"></label>
                <select asp-for="CategoriaID" class="form-select" asp-items="ViewBag.CategoriaID"></select>
                <span asp-validation-for="CategoriaID" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="SubcategoriaID" class="form-label"></label>
                <select asp-for="SubcategoriaID" class="form-select" asp-items="ViewBag.SubcategoriaID"></select>
                <span asp-validation-for="SubcategoriaID" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="NombreServicio" class="form-label"></label>
                <input asp-for="NombreServicio" class="form-control" />
                <span asp-validation-for="NombreServicio" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="Descripcion" class="form-label"></label>
                <textarea asp-for="Descripcion" class="form-control" rows="3"></textarea>
                <span asp-validation-for="Descripcion" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="TarifaDiagnosticoBase" class="form-label"></label>
                <input asp-for="TarifaDiagnosticoBase" type="number" step="0.01" class="form-control" />
                <span asp-validation-for="TarifaDiagnosticoBase" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="TiempoEstimadoMinutos" class="form-label"></label>
                <input asp-for="TiempoEstimadoMinutos" type="number" class="form-control" />
                <span asp-validation-for="TiempoEstimadoMinutos" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="Moneda" class="form-label"></label>
                <select asp-for="Moneda" class="form-select">
                    <option value="CRC">CRC</option>
                    <option value="USD">USD</option>
                </select>
            </div>
            <div class="form-check mb-3">
                <input type="hidden" name="Activo" value="false" />
                <input asp-for="Activo" type="checkbox" class="form-check-input" />
                <label class="form-check-label" for="Activo">Activo</label>
            </div>
            <div><button type="submit" class="btn btn-warning">Actualizar</button> <a asp-action="Index" class="btn btn-secondary">Cancelar</a></div>
        </form>
    </div>
</div>
@section Scripts { @{await Html.RenderPartialAsync("_ValidationScriptsPartial");} }
