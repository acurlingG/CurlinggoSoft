@model CurlinggoSoft.Models.Permiso
@{ ViewData["Title"] = "Editar Permiso"; }
<h1>Editar Permiso</h1>
<div class="row">
    <div class="col-md-6">
        <form asp-action="Edit">
            <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
            <input type="hidden" asp-for="PermisoID" />
            <div class="mb-3">
                <label asp-for="CodigoPermiso" class="form-label"></label>
                <input asp-for="CodigoPermiso" class="form-control" />
            </div>
            <div class="mb-3">
                <label asp-for="Nombre" class="form-label"></label>
                <input asp-for="Nombre" class="form-control" />
            </div>
            <div class="mb-3">
                <label asp-for="Descripcion" class="form-label"></label>
                <textarea asp-for="Descripcion" class="form-control" rows="3"></textarea>
            </div>
            <div class="form-check mb-3">
                <input asp-for="Activo" type="checkbox" class="form-check-input" />
                <label class="form-check-label" for="Activo">Activo</label>
            </div>
            <div><button type="submit" class="btn btn-primary">Guardar</button> <a asp-action="Index" class="btn btn-secondary">Cancelar</a></div>
        </form>
    </div>
</div>
@section Scripts { @{await Html.RenderPartialAsync("_ValidationScriptsPartial");} }
