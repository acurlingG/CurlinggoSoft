@model IEnumerable<CurlinggoSoft.Models.Permiso>
@{ ViewData["Title"] = "Permisos"; }
<h1>Permisos del Sistema</h1>
<p><a asp-action="Create" class="btn btn-primary">+ Nuevo Permiso</a></p>
<table class="table table-striped table-hover">
    <thead class="table-dark">
        <tr><th>Código</th><th>Nombre</th><th>Descripción</th><th>Activo</th><th>Acciones</th></tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.CodigoPermiso</td>
                <td>@item.Nombre</td>
                <td>@item.Descripcion</td>
                <td><span class="badge @(item.Activo ? "bg-success" : "bg-danger")">@(item.Activo ? "Activo" : "Inactivo")</span></td>
                <td>
                    <a asp-action="Details" asp-route-id="@item.PermisoID" class="btn btn-info btn-sm">Ver</a>
                    <a asp-action="Edit" asp-route-id="@item.PermisoID" class="btn btn-warning btn-sm">Editar</a>
                    <a asp-action="Delete" asp-route-id="@item.PermisoID" class="btn btn-danger btn-sm">Eliminar</a>
                </td>
            </tr>
        }
    </tbody>
</table>
<div><a asp-action="Index" asp-controller="Admin" class="btn btn-secondary mt-3">← Volver al Admin</a></div>
