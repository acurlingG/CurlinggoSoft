@model CurlinggoSoft.Models.Permiso
@{ ViewData["Title"] = "Eliminar Permiso"; }
<h1>Eliminar Permiso</h1>
<div class="alert alert-warning"><h4>¿Está seguro?</h4></div>
<dl class="row">
    <dt class="col-sm-2">Código</dt><dd class="col-sm-10">@Model.CodigoPermiso</dd>
    <dt class="col-sm-2">Nombre</dt><dd class="col-sm-10">@Model.Nombre</dd>
</dl>
<form asp-action="Delete">
    <input type="hidden" asp-for="PermisoID" />
    <button type="submit" class="btn btn-danger">Eliminar</button>
    <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
</form>
