@{
    ViewData["Title"] = "Cambiar Contraseña";
}

<div class="container my-5">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card shadow-lg border-0">
                <div class="card-header bg-primary text-white">
                    <h5 class="mb-0">
                        <i class="fa fa-key"></i> Cambiar Contraseña
                    </h5>
                </div>

                <div class="card-body p-4">
                    @if (!ViewData.ModelState.IsValid)
                    {
                        <div class="alert alert-danger alert-dismissible fade show" role="alert">
                            <strong><i class="fa fa-exclamation-triangle"></i> Errores encontrados:</strong>
                            <ul class="mb-0 mt-2">
                                @foreach (var modelState in ViewData.ModelState.Values)
                                {
                                    @foreach (var error in modelState.Errors)
                                    {
                                        <li>@error.ErrorMessage</li>
                                    }
                                }
                            </ul>
                            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Cerrar"></button>
                        </div>
                    }

                    <p class="text-muted mb-4">
                        <i class="fa fa-info-circle"></i>
                        Por tu seguridad, después de cambiar tu contraseña deberás iniciar sesión nuevamente.
                    </p>

                    <form method="post" asp-action="ChangePassword">
                        <!-- Contraseña Actual -->
                        <div class="mb-3">
                            <label for="currentPassword" class="form-label">
                                <i class="fa fa-lock"></i> Contraseña Actual
                            </label>
                            <input type="password" class="form-control" id="currentPassword" name="currentPassword" required />
                            <span class="text-danger small" id="currentPasswordError"></span>
                        </div>

                        <!-- Contraseña Nueva -->
                        <div class="mb-3">
                            <label for="newPassword" class="form-label">
                                <i class="fa fa-lock"></i> Contraseña Nueva
                            </label>
                            <input type="password" class="form-control" id="newPassword" name="newPassword" required />
                            <small class="form-text text-muted d-block mt-1">
                                Mínimo 6 caracteres. Se recomienda usar mayúsculas, minúsculas y números.
                            </small>
                            <span class="text-danger small" id="newPasswordError"></span>
                        </div>

                        <!-- Confirmar Contraseña Nueva -->
                        <div class="mb-4">
                            <label for="confirmPassword" class="form-label">
                                <i class="fa fa-lock"></i> Confirmar Contraseña Nueva
                            </label>
                            <input type="password" class="form-control" id="confirmPassword" name="confirmPassword" required />
                            <span class="text-danger small" id="confirmPasswordError"></span>
                        </div>

                        <!-- Botones de acción -->
                        <div class="d-grid gap-2">
                            <button type="submit" class="btn btn-primary btn-lg">
                                <i class="fa fa-save"></i> Cambiar Contraseña
                            </button>
                            <a href="javascript:history.back()" class="btn btn-outline-secondary">
                                <i class="fa fa-arrow-left"></i> Volver
                            </a>
                        </div>
                    </form>
                </div>

                <div class="card-footer bg-light text-muted small">
                    <i class="fa fa-shield"></i>
                    <strong>Seguridad:</strong> Tu contraseña se transmite de forma segura y encriptada.
                </div>
            </div>

            <!-- Consejo de seguridad -->
            <div class="card card-body bg-warning bg-opacity-10 border-warning mt-4">
                <h6 class="mb-3">
                    <i class="fa fa-lightbulb-o text-warning"></i> Tips de Seguridad
                </h6>
                <ul class="small mb-0">
                    <li>No compartas tu contraseña con nadie, ni siquiera con administradores.</li>
                    <li>Usa combinaciones de letras mayúsculas, minúsculas, números y símbolos.</li>
                    <li>Evita usar información personal como nombres o fechas de nacimiento.</li>
                    <li>Cambia tu contraseña regularmente (cada 3-6 meses es recomendable).</li>
                </ul>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            const newPasswordInput = document.getElementById('newPassword');
            const confirmPasswordInput = document.getElementById('confirmPassword');
            const confirmPasswordError = document.getElementById('confirmPasswordError');

            // Validación en tiempo real de coincidencia de contraseñas
            confirmPasswordInput.addEventListener('input', function() {
                if (this.value && newPasswordInput.value !== this.value) {
                    confirmPasswordError.textContent = 'Las contraseñas no coinciden.';
                    this.classList.add('is-invalid');
                } else {
                    confirmPasswordError.textContent = '';
                    this.classList.remove('is-invalid');
                }
            });

            // Validación de longitud mínima
            newPasswordInput.addEventListener('blur', function() {
                const newPasswordError = document.getElementById('newPasswordError');
                if (this.value && this.value.length < 6) {
                    newPasswordError.textContent = 'Mínimo 6 caracteres.';
                    this.classList.add('is-invalid');
                } else {
                    newPasswordError.textContent = '';
                    this.classList.remove('is-invalid');
                }
            });
        });
    </script>
}
