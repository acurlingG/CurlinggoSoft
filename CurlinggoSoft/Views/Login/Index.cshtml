@{
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="theme-color" content="#075bc9">
    <title>Curling Technologies | Acceso</title>

    <style>
            * {
                box-sizing: border-box;
                margin: 0;
                padding: 0;
            }

            html, body {
                width: 100%;
                min-height: 100%;
            }

            body {
                min-height: 100vh;
                font-family: "Segoe UI", Arial, Helvetica, sans-serif;
                color: #0b315f;
                background: #f8fbff;
                overflow-x: hidden;
                display: flex;
                flex-direction: column;
            }

            /* Fondo luminoso */
            .page {
                position: relative;
                min-height: 100vh;
                display: flex;
                flex-direction: column;
                isolation: isolate;
                overflow: hidden;
            }

                .page::before {
                    content: "";
                    position: absolute;
                    inset: 0;
                    z-index: -3;
                    background: radial-gradient(circle at 50% 12%, rgba(255,255,255,.98) 0 18%, rgba(238,247,255,.78) 48%, rgba(224,239,255,.68) 100%), linear-gradient(180deg, #ffffff 0%, #f5faff 62%, #eef6ff 100%);
                }

            /* Ondas inferiores */
            .waves {
                position: absolute;
                z-index: -1;
                left: -8%;
                bottom: 58px;
                width: 116%;
                height: 330px;
                pointer-events: none;
                overflow: hidden;
            }

            .wave {
                position: absolute;
                width: 120%;
                height: 185px;
                left: -10%;
                border-radius: 50% 50% 0 0 / 100% 100% 0 0;
                transform: rotate(-3deg);
            }

                .wave.one {
                    bottom: -70px;
                    background: rgba(193, 220, 249, .56);
                    box-shadow: 0 -18px 35px rgba(112, 168, 225, .08);
                }

                .wave.two {
                    bottom: -12px;
                    background: rgba(159, 204, 247, .42);
                    transform: rotate(5deg);
                }

                .wave.three {
                    bottom: 40px;
                    background: rgba(103, 170, 238, .34);
                    transform: rotate(-7deg);
                }

            .content {
                flex: 1;
                width: 100%;
                display: flex;
                flex-direction: column;
                align-items: center;
                padding: clamp(30px, 5vh, 64px) 20px 110px;
            }

            /* Logo */
            .brand {
                width: min(610px, 82vw);
                display: flex;
                justify-content: center;
                margin-bottom: 30px;
            }

                .brand img {
                    display: block;
                    width: 100%;
                    height: auto;
                    object-fit: contain;
                    filter: drop-shadow(0 3px 5px rgba(13, 55, 101, .08));
                }

            .separator {
                width: 86px;
                height: 4px;
                border-radius: 10px;
                background: #0866d5;
                margin-bottom: 32px;
            }

            .title {
                font-size: clamp(24px, 2.5vw, 34px);
                line-height: 1.2;
                font-weight: 650;
                color: #0b315f;
                margin-bottom: 28px;
                text-align: center;
            }

            /* Tarjeta */
            .login-card {
                width: min(620px, 92vw);
                background: rgba(255,255,255,.96);
                border: 1px solid rgba(206, 220, 235, .72);
                border-radius: 18px;
                padding: clamp(30px, 4vw, 44px);
                box-shadow: 0 18px 45px rgba(25, 75, 125, .12), 0 4px 14px rgba(25, 75, 125, .06);
                backdrop-filter: blur(8px);
            }

            .field {
                position: relative;
                margin-bottom: 22px;
            }

                .field input {
                    width: 100%;
                    height: 80px;
                    border: 2px solid #d9e2ec;
                    border-radius: 13px;
                    outline: none;
                    padding: 0 62px 0 78px;
                    font-size: 22px;
                    color: #163d6b;
                    background: #fff;
                    transition: border-color .2s ease, box-shadow .2s ease;
                }

                    .field input::placeholder {
                        color: #8e9aaa;
                        opacity: 1;
                    }

                    .field input:focus {
                        border-color: #1772d6;
                        box-shadow: 0 0 0 4px rgba(23,114,214,.10);
                    }

            .field-icon {
                position: absolute;
                left: 25px;
                top: 50%;
                transform: translateY(-50%);
                width: 30px;
                height: 30px;
                color: #0d3d72;
                pointer-events: none;
            }

                .field-icon svg {
                    width: 100%;
                    height: 100%;
                    fill: none;
                    stroke: currentColor;
                    stroke-width: 2;
                    stroke-linecap: round;
                    stroke-linejoin: round;
                }

            .toggle-password {
                position: absolute;
                right: 23px;
                top: 50%;
                transform: translateY(-50%);
                border: 0;
                background: transparent;
                color: #24466e;
                cursor: pointer;
                width: 34px;
                height: 34px;
                padding: 4px;
            }

                .toggle-password svg {
                    width: 100%;
                    height: 100%;
                    fill: none;
                    stroke: currentColor;
                    stroke-width: 2;
                    stroke-linecap: round;
                    stroke-linejoin: round;
                }

            .submit {
                width: 100%;
                height: 78px;
                border: 0;
                border-radius: 12px;
                background: linear-gradient(180deg, #0867d8 0%, #075bc9 100%);
                color: white;
                font-size: 23px;
                font-weight: 650;
                cursor: pointer;
                box-shadow: 0 8px 18px rgba(7, 91, 201, .22);
                transition: transform .18s ease, box-shadow .18s ease, filter .18s ease;
                margin-top: 2px;
            }

                .submit:hover {
                    filter: brightness(1.05);
                    transform: translateY(-1px);
                    box-shadow: 0 10px 23px rgba(7, 91, 201, .28);
                }

                .submit:active {
                    transform: translateY(0);
                }

            .forgot {
                display: block;
                text-align: center;
                margin-top: 29px;
                color: #075fcf;
                text-decoration: none;
                font-size: 20px;
                font-weight: 500;
            }

                .forgot:hover {
                    text-decoration: underline;
                }

            /* Footer */
            footer {
                position: absolute;
                z-index: 2;
                left: 0;
                bottom: 0;
                width: 100%;
                min-height: 82px;
                display: flex;
                align-items: center;
                justify-content: center;
                padding: 18px 20px;
                color: white;
                background: linear-gradient(90deg, #075acb 0%, #075fcf 50%, #075acb 100%);
                font-size: 17px;
                text-align: center;
                letter-spacing: .1px;
            }

            /* Tablet */
            @@media (max-width: 800px) {
                .content {
                    padding-top: 32px;
                    padding-bottom: 105px;
                }

                .brand {
                    width: min(520px, 88vw);
                    margin-bottom: 25px;
                }

                .separator {
                    margin-bottom: 24px;
                }

                .login-card {
                    width: min(560px, 92vw);
                }

                .field input {
                    height: 68px;
                    font-size: 19px;
                    padding-left: 66px;
                }

                .submit {
                    height: 68px;
                    font-size: 20px;
                }

                .forgot {
                    font-size: 18px;
                }

                .waves {
                    bottom: 58px;
                    height: 270px;
                }
            }

            /* Celulares */
            @@media (max-width: 520px) {
                .content {
                    padding: 25px 14px 95px;
                    justify-content: flex-start;
                }

                .brand {
                    width: min(390px, 92vw);
                    margin-bottom: 20px;
                }

                .separator {
                    width: 62px;
                    height: 3px;
                    margin-bottom: 20px;
                }

                .title {
                    font-size: 23px;
                    margin-bottom: 20px;
                }

                .login-card {
                    width: 100%;
                    padding: 23px 18px 27px;
                    border-radius: 15px;
                }

                .field {
                    margin-bottom: 15px;
                }

                    .field input {
                        height: 58px;
                        border-radius: 10px;
                        font-size: 17px;
                        padding-left: 52px;
                        padding-right: 52px;
                    }

                .field-icon {
                    left: 17px;
                    width: 23px;
                    height: 23px;
                }

                .toggle-password {
                    right: 14px;
                    width: 29px;
                    height: 29px;
                }

                .submit {
                    height: 58px;
                    border-radius: 9px;
                    font-size: 18px;
                }

                .forgot {
                    margin-top: 20px;
                    font-size: 16px;
                }

                footer {
                    min-height: 62px;
                    padding: 13px 12px;
                    font-size: 13px;
                }

                .waves {
                    bottom: 48px;
                    height: 190px;
                }
            }

            @@media (prefers-reduced-motion: reduce) {
                * {
                    scroll-behavior: auto !important;
                    transition: none !important;
                }
            }
    </style>
</head>

<body>
    <div class="page">

        <main class="content">

            <div class="brand">
                <img src="data:image/jpeg;base64," alt="Curling Technologies">
            </div>

            <div class="separator"></div>

            <h1 class="title">Acceso a tu cuenta</h1>

            <form class="login-card" id="loginForm" method="post" asp-action="Authenticate" autocomplete="on">

                <div class="field">
                    <span class="field-icon" aria-hidden="true">
                        <svg viewBox="0 0 24 24">
                            <circle cx="12" cy="8" r="4"></circle>
                            <path d="M4 21c.7-4 3.3-6 8-6s7.3 2 8 6"></path>
                        </svg>
                    </span>
                    <input type="text"
                           id="usuario"
                           name="usuario"
                           placeholder="Usuario"
                           autocomplete="username"
                           required>
                    <span style="color: red; display: none;" id="usuarioError"></span>
                </div>

                <div class="field">
                    <span class="field-icon" aria-hidden="true">
                        <svg viewBox="0 0 24 24">
                            <rect x="4" y="10" width="16" height="11" rx="2"></rect>
                            <path d="M8 10V7a4 4 0 0 1 8 0v3"></path>
                            <circle cx="12" cy="15.5" r="1"></circle>
                        </svg>
                    </span>

                    <input type="password"
                           id="clave"
                           name="clave"
                           placeholder="Clave"
                           autocomplete="current-password"
                           required>

                    <button type="button"
                            class="toggle-password"
                            id="togglePassword"
                            aria-label="Mostrar clave"
                            title="Mostrar clave">
                        <svg viewBox="0 0 24 24">
                            <path d="M2 12s3.5-6 10-6 10 6 10 6-3.5 6-10 6S2 12 2 12z"></path>
                            <circle cx="12" cy="12" r="2.5"></circle>
                        </svg>
                    </button>
                    <span style="color: red; display: none;" id="claveError"></span>
                </div>

                <button type="submit" class="submit">Iniciar Sesión</button>

                <a href="@Url.Action("RecoverPassword")" class="forgot">¿Olvidaste tu clave?</a>
            </form>
        </main>

        <div class="waves" aria-hidden="true">
            <div class="wave one"></div>
            <div class="wave two"></div>
            <div class="wave three"></div>
        </div>

        <footer>
            © 2026 Curling Technologies. Todos los derechos reservados.
        </footer>

    </div>

    <script>
            // Mostrar / ocultar contraseña
            const password = document.getElementById("clave");
            const toggle = document.getElementById("togglePassword");

            toggle.addEventListener("click", () => {
                const visible = password.type === "text";
                password.type = visible ? "password" : "text";
                toggle.setAttribute("aria-label", visible ? "Mostrar clave" : "Ocultar clave");
                toggle.setAttribute("title", visible ? "Mostrar clave" : "Ocultar clave");
            });

            // Validación local del formulario antes de enviar al servidor
            document.getElementById("loginForm").addEventListener("submit", (event) => {
                const usuario = document.getElementById("usuario").value.trim();
                const clave = document.getElementById("clave").value.trim();

                // Limpiar mensajes de error previos
                document.getElementById("usuarioError").style.display = "none";
                document.getElementById("claveError").style.display = "none";

                let isValid = true;

                if (!usuario) {
                    document.getElementById("usuarioError").textContent = "El usuario es requerido";
                    document.getElementById("usuarioError").style.display = "block";
                    isValid = false;
                }

                if (!clave) {
                    document.getElementById("claveError").textContent = "La contraseña es requerida";
                    document.getElementById("claveError").style.display = "block";
                    isValid = false;
                }

                if (!isValid) {
                    event.preventDefault();
                }
                // Si es válido, el formulario POST se envía al servidor automáticamente
            });
    </script>
</body>
</html>
