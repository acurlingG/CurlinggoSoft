@{
    ViewData["Title"] = "Acceso";
    ViewData["HideAdminMenu"] = true;
    Layout = "_Layout";
}

<style>
    .login-wrapper {
        display: flex;
        flex-direction: column;
        align-items: center;
        padding: 40px 20px 60px;
    }

    .login-wrapper .separator {
        width: 62px;
        height: 3px;
        border-radius: 10px;
        background: #0866d5;
        margin-bottom: 24px;
    }

    .login-wrapper .title {
        font-size: 28px;
        font-weight: 650;
        color: #0b315f;
        margin-bottom: 24px;
        text-align: center;
    }

    .login-card {
        width: min(480px, 92vw);
        background: rgba(255,255,255,.96);
        border: 1px solid rgba(206, 220, 235, .72);
        border-radius: 18px;
        padding: 32px;
        box-shadow: 0 18px 45px rgba(25, 75, 125, .12), 0 4px 14px rgba(25, 75, 125, .06);
    }

    .field {
        position: relative;
        margin-bottom: 20px;
    }

        .field input {
            width: 100%;
            height: 56px;
            border: 2px solid #d9e2ec;
            border-radius: 10px;
            outline: none;
            padding: 0 50px 0 52px;
            font-size: 17px;
            color: #163d6b;
            background: #fff;
            transition: border-color .2s ease, box-shadow .2s ease;
        }

            .field input::placeholder {
                color: #8e9aaa;
                opacity: 1;
            }

            .field input:focus {
                border-color: #1772d6;
                box-shadow: 0 0 0 4px rgba(23,114,214,.10);
            }

    .field-icon {
        position: absolute;
        left: 16px;
        top: 50%;
        transform: translateY(-50%);
        width: 22px;
        height: 22px;
        color: #0d3d72;
        pointer-events: none;
    }

        .field-icon svg {
            width: 100%;
            height: 100%;
            fill: none;
            stroke: currentColor;
            stroke-width: 2;
            stroke-linecap: round;
            stroke-linejoin: round;
        }

    .toggle-password {
        position: absolute;
        right: 14px;
        top: 50%;
        transform: translateY(-50%);
        border: 0;
        background: transparent;
        color: #24466e;
        cursor: pointer;
        width: 28px;
        height: 28px;
        padding: 3px;
    }

        .toggle-password svg {
            width: 100%;
            height: 100%;
            fill: none;
            stroke: currentColor;
            stroke-width: 2;
            stroke-linecap: round;
            stroke-linejoin: round;
        }

    .submit {
        width: 100%;
        height: 56px;
        border: 0;
        border-radius: 10px;
        background: linear-gradient(180deg, #1a7bea 0%, #0a5cc4 100%);
        color: #fff;
        font-size: 18px;
        font-weight: 600;
        cursor: pointer;
        margin-top: 4px;
    }

        .submit:hover {
            filter: brightness(1.05);
        }

    .forgot {
        display: block;
        text-align: center;
        margin-top: 18px;
        font-size: 15px;
        color: #1772d6;
        text-decoration: none;
    }

        .forgot:hover {
            text-decoration: underline;
        }
</style>

<div class="login-wrapper">
    <div class="separator"></div>
    <h1 class="title">Acceso a tu cuenta</h1>

    <form class="login-card" id="loginForm" method="post" asp-controller="Account" asp-action="Login" asp-route-returnUrl="@ViewData["ReturnUrl"]" autocomplete="on">

        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

        <div class="field">
            <span class="field-icon" aria-hidden="true">
                <svg viewBox="0 0 24 24">
                    <circle cx="12" cy="8" r="4"></circle>
                    <path d="M4 21c.7-4 3.3-6 8-6s7.3 2 8 6"></path>
                </svg>
            </span>
            <input type="text"
                   id="usuario"
                   name="usuario"
                   placeholder="Usuario"
                   autocomplete="username"
                   required>
            <span style="color: red; display: none;" id="usuarioError"></span>
        </div>

        <div class="field">
            <span class="field-icon" aria-hidden="true">
                <svg viewBox="0 0 24 24">
                    <rect x="4" y="10" width="16" height="11" rx="2"></rect>
                    <path d="M8 10V7a4 4 0 0 1 8 0v3"></path>
                    <circle cx="12" cy="15.5" r="1"></circle>
                </svg>
            </span>

            <input type="password"
                   id="clave"
                   name="clave"
                   placeholder="Clave"
                   autocomplete="current-password"
                   required>

            <button type="button"
                    class="toggle-password"
                    id="togglePassword"
                    aria-label="Mostrar clave"
                    title="Mostrar clave">
                <svg viewBox="0 0 24 24">
                    <path d="M2 12s3.5-6 10-6 10 6 10 6-3.5 6-10 6S2 12 2 12z"></path>
                    <circle cx="12" cy="12" r="2.5"></circle>
                </svg>
            </button>
            <span style="color: red; display: none;" id="claveError"></span>
        </div>

        <button type="submit" class="submit">Iniciar Sesión</button>

        <a href="@Url.Action("RecoverPassword", "Account")" class="forgot">¿Olvidaste tu clave?</a>
    </form>
</div>

@section Scripts {
    <script>
        const togglePassword = document.getElementById("togglePassword");
        const claveInput = document.getElementById("clave");

        togglePassword.addEventListener("click", () => {
            const visible = claveInput.getAttribute("type") === "text";
            claveInput.setAttribute("type", visible ? "password" : "text");
            togglePassword.setAttribute("title", visible ? "Mostrar clave" : "Ocultar clave");
        });

        // Validación local del formulario antes de enviar al servidor
        document.getElementById("loginForm").addEventListener("submit", (event) => {
            const usuario = document.getElementById("usuario").value.trim();
            const clave = document.getElementById("clave").value.trim();

            // Limpiar mensajes de error previos
            document.getElementById("usuarioError").style.display = "none";
            document.getElementById("claveError").style.display = "none";

            let isValid = true;

            if (!usuario) {
                document.getElementById("usuarioError").textContent = "El usuario es requerido";
                document.getElementById("usuarioError").style.display = "block";
                isValid = false;
            }

            if (!clave) {
                document.getElementById("claveError").textContent = "La contraseña es requerida";
                document.getElementById("claveError").style.display = "block";
                isValid = false;
            }

            if (!isValid) {
                event.preventDefault();
            }
            // Si es válido, el formulario POST se envía al servidor automáticamente
        });
    </script>
}
