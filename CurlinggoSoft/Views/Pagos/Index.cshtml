@model IEnumerable<CurlinggoSoft.Models.Pago>
@{ ViewData["Title"] = "Pagos"; }
<h1>Pagos</h1>
<p><a asp-action="Create" class="btn btn-primary">+ Nuevo Pago</a></p>
<table class="table table-striped table-hover">
    <thead class="table-dark"><tr><th>Reserva</th><th>Monto Total</th><th>Comisión</th><th>Neto Técnico</th><th>Moneda</th><th>Fecha</th><th>Acciones</th></tr></thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.Reserva?.ReservaID</td>
                <td>@item.MontoTotal</td>
                <td>@item.ComisionPlataforma</td>
                <td>@item.MontoNetoTecnico</td>
                <td>@item.Moneda</td>
                <td>@item.FechaCreacion</td>
                <td>
                    <a asp-action="Details" asp-route-id="@item.PagoID" class="btn btn-info btn-sm">Ver</a>
                    <a asp-action="Edit" asp-route-id="@item.PagoID" class="btn btn-warning btn-sm">Editar</a>
                    <a asp-action="Delete" asp-route-id="@item.PagoID" class="btn btn-danger btn-sm">Eliminar</a>
                </td>
            </tr>
        }
    </tbody>
</table>
<div><a asp-action="Index" asp-controller="Admin" class="btn btn-secondary mt-3">← Volver al Admin</a></div>
