@model CurlinggoSoft.Models.Pago
@{ ViewData["Title"] = "Detalles Pago"; }
<h1>Detalles de Pago</h1>
<dl class="row">
    <dt class="col-sm-2">Reserva</dt><dd class="col-sm-10">@Model.Reserva?.ReservaID</dd>
    <dt class="col-sm-2">Monto Total</dt><dd class="col-sm-10">@Model.MontoTotal</dd>
    <dt class="col-sm-2">Comisión</dt><dd class="col-sm-10">@Model.ComisionPlataforma</dd>
    <dt class="col-sm-2">Neto Técnico</dt><dd class="col-sm-10">@Model.MontoNetoTecnico</dd>
    <dt class="col-sm-2">Moneda</dt><dd class="col-sm-10">@Model.Moneda</dd>
</dl>
<div><a asp-action="Edit" asp-route-id="@Model.PagoID" class="btn btn-warning">Editar</a> <a asp-action="Index" class="btn btn-secondary">Volver</a></div>
