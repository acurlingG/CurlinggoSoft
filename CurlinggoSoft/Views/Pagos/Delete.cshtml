@model CurlinggoSoft.Models.Pago
@{ ViewData["Title"] = "Eliminar Pago"; }
<h1>Eliminar Pago</h1>
<div class="alert alert-warning"><h4>¿Está seguro?</h4></div>
<dl class="row"><dt class="col-sm-2">Monto Total</dt><dd class="col-sm-10">@Model.MontoTotal</dd></dl>
<form asp-action="Delete">
    <input type="hidden" asp-for="PagoID" />
    <button type="submit" class="btn btn-danger">Eliminar</button>
    <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
</form>
