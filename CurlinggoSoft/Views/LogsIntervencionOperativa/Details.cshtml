@model CurlinggoSoft.Models.LogIntervencionOperativa
@{ ViewData["Title"] = "Detalles Log"; }
<h1>Detalles de Log de Intervención</h1>
<dl class="row">
    <dt class="col-sm-2">Reserva</dt><dd class="col-sm-10">@Model.Reserva?.ReservaID</dd>
    <dt class="col-sm-2">Tipo Evento</dt><dd class="col-sm-10">@Model.TipoEvento</dd>
    <dt class="col-sm-2">Datos Entrada</dt><dd class="col-sm-10">@Model.DatosEntradaJson</dd>
    <dt class="col-sm-2">Decisión</dt><dd class="col-sm-10">@Model.DecisionTomada</dd>
    <dt class="col-sm-2">Modelo</dt><dd class="col-sm-10">@Model.ModeloVersion</dd>
    <dt class="col-sm-2">Fecha</dt><dd class="col-sm-10">@Model.FechaRegistro</dd>
</dl>
<div><a asp-action="Index" class="btn btn-secondary">Volver</a></div>
