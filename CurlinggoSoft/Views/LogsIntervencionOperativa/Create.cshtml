@model CurlinggoSoft.Models.LogIntervencionOperativa
@{ ViewData["Title"] = "Crear Log de Intervención"; }
<h1>Crear Log de Intervención Operativa</h1>
<div class="row"><div class="col-md-6">
<form asp-action="Create">
    <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
    <div class="mb-3"><label asp-for="ReservaID" class="form-label"></label><select asp-for="ReservaID" class="form-select" asp-items="ViewBag.ReservaID"><option value="">-- Ninguna --</option></select></div>
    <div class="mb-3"><label asp-for="TipoEvento" class="form-label"></label><input asp-for="TipoEvento" class="form-control" /></div>
    <div class="mb-3"><label asp-for="DatosEntradaJson" class="form-label"></label><textarea asp-for="DatosEntradaJson" class="form-control"></textarea></div>
    <div class="mb-3"><label asp-for="DecisionTomada" class="form-label"></label><textarea asp-for="DecisionTomada" class="form-control"></textarea></div>
    <div class="mb-3"><label asp-for="ModeloVersion" class="form-label"></label><input asp-for="ModeloVersion" class="form-control" /></div>
    <div class="mb-3"><label asp-for="UsuarioIntervencionID" class="form-label"></label><select asp-for="UsuarioIntervencionID" class="form-select" asp-items="ViewBag.UsuarioIntervencionID"><option value="">-- Ninguno --</option></select></div>
    <div><button type="submit" class="btn btn-primary">Guardar</button> <a asp-action="Index" class="btn btn-secondary">Cancelar</a></div>
</form>
</div></div>
@section Scripts { @{await Html.RenderPartialAsync("_ValidationScriptsPartial");} }
