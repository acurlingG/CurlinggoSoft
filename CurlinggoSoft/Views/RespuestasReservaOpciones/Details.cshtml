@model CurlinggoSoft.Models.RespuestaReservaOpcion
@{ ViewData["Title"] = "Detalles Respuesta Opción"; }
<h1>Detalles de Respuesta de Opción</h1>
<dl class="row">
    <dt class="col-sm-2">Respuesta</dt><dd class="col-sm-10">@Model.RespuestaReserva?.RespuestaReservaID</dd>
    <dt class="col-sm-2">Opción</dt><dd class="col-sm-10">@Model.Opcion?.TextoOpcion</dd>
</dl>
<div><a asp-action="Edit" asp-route-id="@Model.RespuestaReservaOpcionID" class="btn btn-warning">Editar</a> <a asp-action="Index" class="btn btn-secondary">Volver</a></div>
