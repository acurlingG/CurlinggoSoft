@model CurlinggoSoft.Models.RespuestaReservaOpcion
@{ ViewData["Title"] = "Eliminar Respuesta Opción"; }
<h1>Eliminar Respuesta de Opción</h1>
<div class="alert alert-warning"><h4>¿Está seguro?</h4></div>
<dl class="row"><dt class="col-sm-2">Respuesta</dt><dd class="col-sm-10">@Model.RespuestaReserva?.RespuestaReservaID</dd></dl>
<form asp-action="Delete">
    <input type="hidden" asp-for="RespuestaReservaOpcionID" />
    <button type="submit" class="btn btn-danger">Eliminar</button>
    <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
</form>
