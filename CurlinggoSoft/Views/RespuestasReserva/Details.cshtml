@model CurlinggoSoft.Models.RespuestaReserva
@{ ViewData["Title"] = "Detalles Respuesta"; }
<h1>Detalles de Respuesta</h1>
<dl class="row">
    <dt class="col-sm-2">Reserva</dt><dd class="col-sm-10">@Model.Reserva?.ReservaID</dd>
    <dt class="col-sm-2">Pregunta</dt><dd class="col-sm-10">@Model.Pregunta?.TextoPregunta</dd>
    <dt class="col-sm-2">Opción</dt><dd class="col-sm-10">@Model.Opcion?.TextoOpcion</dd>
    <dt class="col-sm-2">Respuesta</dt><dd class="col-sm-10">@Model.RespuestaTexto</dd>
</dl>
<div><a asp-action="Edit" asp-route-id="@Model.RespuestaReservaID" class="btn btn-warning">Editar</a> <a asp-action="Index" class="btn btn-secondary">Volver</a></div>
