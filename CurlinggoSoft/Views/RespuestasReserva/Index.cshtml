@model IEnumerable<CurlinggoSoft.Models.RespuestaReserva>
@{ ViewData["Title"] = "Respuestas Reserva"; }
<h1>Respuestas de Reserva</h1>
<p><a asp-action="Create" class="btn btn-primary">+ Nueva Respuesta</a></p>
<table class="table table-striped table-hover">
    <thead class="table-dark"><tr><th>Reserva</th><th>Pregunta</th><th>Opción</th><th>Respuesta</th><th>Fecha</th><th>Acciones</th></tr></thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.Reserva?.ReservaID</td>
                <td>@item.Pregunta?.TextoPregunta</td>
                <td>@item.Opcion?.TextoOpcion</td>
                <td>@item.RespuestaTexto</td>
                <td>@item.FechaRespuesta</td>
                <td>
                    <a asp-action="Details" asp-route-id="@item.RespuestaReservaID" class="btn btn-info btn-sm">Ver</a>
                    <a asp-action="Edit" asp-route-id="@item.RespuestaReservaID" class="btn btn-warning btn-sm">Editar</a>
                    <a asp-action="Delete" asp-route-id="@item.RespuestaReservaID" class="btn btn-danger btn-sm">Eliminar</a>
                </td>
            </tr>
        }
    </tbody>
</table>
<div><a asp-action="Index" asp-controller="Admin" class="btn btn-secondary mt-3">← Volver al Admin</a></div>
