@{
    ViewData["Title"] = "Nosotros";
}

@section Styles {
    <link rel="stylesheet"
          href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/4.7.0/css/font-awesome.min.css">

    
    <link rel="stylesheet"
          href="~/css/nosotros.css"
          asp-append-version="true" />
    

}

<!-- =========================================================
     HERO
     ========================================================= -->

<section class="about-hero">

    
    <div class="site-container">

        <div class="about-hero-content">

            <span class="about-kicker">
                SOBRE CURLINGgo
            </span>

            <h1>
                Conectamos necesidades
                <strong>con soluciones.</strong>
            </h1>

            <p>
                CURLINGgo nace para hacer más sencillo encontrar,
                solicitar y recibir servicios profesionales,
                conectando a personas que necesitan resolver algo
                con profesionales que pueden ayudarles.
            </p>

        </div>

    </div>
    

</section>

<!-- =========================================================
     ¿QUÉ ES CURLINGgo?
     ========================================================= -->

<section class="about-section about-introduction">

    
    <div class="site-container">

        <div class="about-section-heading">

            <span class="about-kicker">
                ¿QUÉ ES CURLINGgo?
            </span>

            <h2>
                Una nueva forma de encontrar servicios.
            </h2>

        </div>


        <div class="about-text">

            <p>
                CURLINGgo es una plataforma digital creada para facilitar
                la conexión entre personas que necesitan un servicio y
                profesionales que cuentan con las habilidades para realizarlo.
            </p>

            <p>
                Nuestra propuesta parte de una necesidad muy sencilla:
                cuando una persona necesita reparar, instalar, mantener
                o resolver algo, muchas veces debe invertir tiempo buscando
                recomendaciones, contactando diferentes personas y explicando
                varias veces qué es lo que necesita.
            </p>

            <p>
                CURLINGgo busca simplificar ese proceso. En lugar de comenzar
                buscando directamente a una persona, el usuario comienza
                indicando <strong>qué necesita</strong>. La plataforma organiza
                esa necesidad, obtiene la información necesaria para comprender
                el servicio y facilita la conexión con profesionales que pueden
                atenderlo.
            </p>

            <p>
                De esta manera, CURLINGgo funciona como un
                <strong>intermediario digital</strong> entre la necesidad y
                la solución. Nuestro objetivo es reducir la cantidad de pasos
                que una persona debe realizar para llegar al resultado que busca.
            </p>

            <p>
                La plataforma está pensada para crecer alrededor de diferentes
                categorías y especialidades de servicios, incorporando
                ubicación, disponibilidad, perfiles profesionales,
                calificaciones y otros elementos que permitan construir
                una experiencia más organizada y confiable.
            </p>

            <p>
                Para los profesionales, CURLINGgo representa también una
                oportunidad para ampliar su alcance, encontrar nuevas
                oportunidades de trabajo y construir una reputación digital
                basada en los servicios realizados y en la experiencia de
                sus clientes.
            </p>

        </div>

    </div>
    

</section>

<!-- =========================================================
     MISIÓN
     ========================================================= -->

<section class="about-section mission-section">

    
    <div class="site-container">

        <div class="mission-grid">

            <div class="mission-icon">
                <i class="fa fa-compass"></i>
            </div>

            <div>

                <span class="about-kicker">
                    NUESTRA MISIÓN
                </span>

                <h2>
                    Hacer que encontrar un servicio profesional
                    sea tan sencillo como solicitarlo.
                </h2>

                <p>
                    Nuestra misión es conectar de manera simple, organizada
                    y confiable a las personas que necesitan resolver una
                    necesidad con profesionales capaces de atenderla,
                    utilizando tecnología para reducir la distancia entre
                    el problema y la solución.
                </p>

                <p>
                    Queremos que cada solicitud tenga un camino claro:
                    entender la necesidad, encontrar las opciones adecuadas,
                    facilitar la conexión y acompañar el proceso hasta
                    completar el servicio.
                </p>

                <p>
                    Al mismo tiempo, buscamos brindar a los profesionales
                    una herramienta que les permita mostrar sus capacidades,
                    acceder a nuevas oportunidades y desarrollar una
                    reputación digital basada en el valor que entregan.
                </p>

            </div>

        </div>

    </div>
    

</section>

<!-- =========================================================
     VISIÓN
     ========================================================= -->

<section class="about-section vision-section">

    
    <div class="site-container">

        <div class="vision-content">

            <span class="about-kicker">
                NUESTRA VISIÓN
            </span>

            <h2>
                Convertirnos en la plataforma de referencia para
                encontrar y ofrecer servicios profesionales.
            </h2>

            <p>
                Visualizamos un ecosistema digital en el que una persona
                no tenga que preguntarse dónde encontrar a alguien para
                resolver una necesidad. Simplemente podrá describir lo que
                necesita y CURLINGgo se encargará de facilitar el camino
                hacia una solución.
            </p>

            <p>
                Queremos evolucionar desde una plataforma de conexión hacia
                una infraestructura digital de servicios locales, donde
                categorías, especialidades, ubicación, disponibilidad,
                experiencia y reputación trabajen juntas para generar
                conexiones más relevantes.
            </p>

            <p>
                Nuestra visión es construir una plataforma que pueda crecer
                más allá de una ciudad o de una categoría específica,
                manteniendo siempre una experiencia sencilla para quien
                necesita un servicio y una oportunidad real para quien
                ofrece sus conocimientos y habilidades.
            </p>

        </div>

    </div>
    

</section>

<!-- =========================================================
     CÓMO NACIÓ
     ========================================================= -->

<section class="about-section origin-section">

    
    <div class="site-container">

        <div class="about-section-heading">

            <span class="about-kicker">
                CÓMO NACIÓ CURLINGgo
            </span>

            <h2>
                Una idea construida con experiencia
                y una necesidad real.
            </h2>

        </div>


        <div class="origin-content">

            <p>
                CURLINGgo es el resultado de un proyecto que se ha venido
                desarrollando durante años a partir de una idea sencilla:
                utilizar la tecnología para facilitar algo que las personas
                hacen constantemente, encontrar a alguien que pueda ayudarles
                a resolver una necesidad.
            </p>

            <p>
                El proyecto tiene sus raíces en
                <strong>Curling Technologies S.A.</strong>, empresa que durante
                años ha desarrollado soluciones de software y brindado
                servicios de soporte técnico, acumulando experiencia en
                tecnología, desarrollo de aplicaciones y atención de
                necesidades empresariales.
            </p>

            <p>
                A partir de esa experiencia surgió la posibilidad de llevar
                el conocimiento tecnológico a un problema cotidiano:
                encontrar de manera rápida y organizada a la persona
                adecuada para realizar un servicio.
            </p>

            <p>
                La idea evolucionó hasta convertirse en CURLINGgo:
                una plataforma que busca actuar como intermediario entre
                quienes necesitan un servicio y quienes tienen las
                capacidades para ofrecerlo.
            </p>

            <p>
                El objetivo siempre ha sido el mismo:
                <strong>
                    reducir la cantidad de pasos necesarios para obtener
                    el resultado deseado.
                </strong>
            </p>

        </div>

    </div>
    

</section>

<!-- =========================================================
     QUIÉN ESTÁ DETRÁS
     ========================================================= -->

<section class="founder-section">

    
    <div class="site-container">

        <div class="founder-content">

            <div class="founder-photo-wrapper">

                <div class="founder-photo">

                    <img src="~/images/CEO.png"
                         alt="Fundador de CURLINGgo" />

                </div>

            </div>


            <div class="founder-text">

                <span class="about-kicker">
                    QUIÉN ESTÁ DETRÁS
                </span>

                <h2>
                    Tecnología, experiencia y visión de producto.
                </h2>

                <p>
                    CURLINGgo es impulsado desde una trayectoria profesional
                    desarrollada durante muchos años en el área de tecnología
                    y sistemas de información.
                </p>

                <p>
                    Su fundador es <strong>Ingeniero en Sistemas</strong>,
                    con experiencia profesional en empresas internacionales
                    y en diferentes áreas relacionadas con tecnología,
                    desarrollo de software, aplicaciones empresariales,
                    soporte y gestión de soluciones tecnológicas.
                </p>

                <p>
                    Esta trayectoria también se complementa con experiencia
                    como <strong>profesor universitario</strong>, actividad
                    que ha permitido mantener un vínculo permanente con la
                    formación de nuevos profesionales y con la evolución
                    de las tecnologías que están transformando la forma
                    en que trabajamos y resolvemos problemas.
                </p>

                <p>
                    CURLINGgo representa la evolución de esa experiencia
                    hacia un proyecto propio: utilizar tecnología para
                    resolver un problema cotidiano de una manera más simple,
                    estructurada y accesible.
                </p>

            </div>

        </div>

    </div>
    

</section>

<!-- =========================================================
     POR QUÉ CURLINGgo
     ========================================================= -->

<section class="about-section differentiation-section">

    
    <div class="site-container">

        <div class="about-section-heading centered">

            <span class="about-kicker">
                ¿POR QUÉ CURLINGgo?
            </span>

            <h2>
                No queremos ser solamente un directorio.
            </h2>

            <p>
                Queremos transformar la forma en que las personas
                encuentran y solicitan servicios.
            </p>

        </div>


        <div class="differentiation-grid">

            <div class="difference-card">

                <div class="difference-icon">
                    <i class="fa fa-exchange"></i>
                </div>

                <h3>
                    De la necesidad a la solución
                </h3>

                <p>
                    El usuario no necesita conocer previamente al profesional.
                    Comienza indicando qué necesita y la plataforma organiza
                    el proceso.
                </p>

            </div>


            <div class="difference-card">

                <div class="difference-icon">
                    <i class="fa fa-map-marker"></i>
                </div>

                <h3>
                    Conexión inteligente
                </h3>

                <p>
                    La ubicación, especialidad y disponibilidad pueden utilizarse
                    para facilitar conexiones más relevantes entre clientes
                    y profesionales.
                </p>

            </div>


            <div class="difference-card">

                <div class="difference-icon">
                    <i class="fa fa-users"></i>
                </div>

                <h3>
                    Dos lados de la plataforma
                </h3>

                <p>
                    CURLINGgo está pensado tanto para quien necesita resolver
                    algo como para quien posee las habilidades para ofrecer
                    una solución.
                </p>

            </div>


            <div class="difference-card">

                <div class="difference-icon">
                    <i class="fa fa-line-chart"></i>
                </div>

                <h3>
                    Construcción de reputación
                </h3>

                <p>
                    Las calificaciones y la experiencia acumulada pueden
                    convertirse en parte del valor digital de cada profesional.
                </p>

            </div>

        </div>

    </div>
    

</section>

<!-- =========================================================
     CONFIANZA Y SEGURIDAD
     ========================================================= -->

<section class="about-section trust-about-section">

    
    <div class="site-container">

        <div class="trust-about-grid">

            <div>

                <span class="about-kicker">
                    CONFIANZA Y SEGURIDAD
                </span>

                <h2>
                    La tecnología conecta.
                    La confianza hace posible la relación.
                </h2>

                <p>
                    En CURLINGgo entendemos que conectar a una persona
                    con un profesional implica mucho más que encontrar
                    un nombre en una lista.
                </p>

                <p>
                    Por eso la plataforma está siendo diseñada para
                    incorporar elementos como perfiles profesionales,
                    especialidades, ubicación, solicitudes estructuradas,
                    calificaciones y seguimiento del servicio.
                </p>

                <p>
                    Nuestro objetivo es crear un entorno donde la
                    información y la experiencia de los usuarios ayuden
                    progresivamente a construir confianza dentro de la
                    comunidad CURLINGgo.
                </p>

            </div>


            <div class="trust-about-items">

                <div class="trust-about-item">

                    <i class="fa fa-user"></i>

                    <div>
                        <strong>
                            Perfiles profesionales
                        </strong>

                        <span>
                            Información organizada sobre los técnicos.
                        </span>
                    </div>

                </div>


                <div class="trust-about-item">

                    <i class="fa fa-star"></i>

                    <div>
                        <strong>
                            Calificaciones
                        </strong>

                        <span>
                            Experiencias que ayudan a tomar decisiones.
                        </span>
                    </div>

                </div>


                <div class="trust-about-item">

                    <i class="fa fa-map-marker"></i>

                    <div>
                        <strong>
                            Ubicación
                        </strong>

                        <span>
                            Facilita la conexión con profesionales de cada zona.
                        </span>
                    </div>

                </div>


                <div class="trust-about-item">

                    <i class="fa fa-shield"></i>

                    <div>
                        <strong>
                            Proceso organizado
                        </strong>

                        <span>
                            Una solicitud estructurada desde el inicio hasta el final.
                        </span>
                    </div>

                </div>

            </div>

        </div>

    </div>
    

</section>

<!-- =========================================================
     CIERRE
     ========================================================= -->

<section class="about-closing">

    
    <div class="site-container">

        <div class="about-closing-content">

            <span>
                CURLINGgo
            </span>

            <h2>
                Una necesidad.
                Un profesional.
                Una conexión.
            </h2>

            <p>
                Estamos construyendo una forma más sencilla de encontrar
                y ofrecer servicios profesionales.
            </p>

            <a asp-controller="SolicitudServicio"
               asp-action="Paso1Servicio"
               class="btn btn-brand btn-lg">
                <i class="fa fa-search"></i>
                Buscar un servicio
            </a>

        </div>

    </div>
    

</section>
