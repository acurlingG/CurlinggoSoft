@model List<CurlinggoSoft.Models.Servicio>

@{
    ViewData["Title"] = "Inicio";


// Ícono según la categoría del servicio.
string IconoPara(string? categoria)
    {
        var c = (categoria ?? "").ToLowerInvariant();

        if (c.Contains("fontan") || c.Contains("plomer") || c.Contains("fuga"))
            return "fa-wrench";

        if (c.Contains("electric"))
            return "fa-bolt";

        if (c.Contains("soporte") || c.Contains("red") ||
            c.Contains("cómputo") || c.Contains("computo") ||
            c.Contains("tecnología") || c.Contains("tecnologia"))
            return "fa-desktop";

        if (c.Contains("handyman") || c.Contains("reparac"))
            return "fa-hammer";

        if (c.Contains("limpieza"))
            return "fa-tint";

        if (c.Contains("pintura"))
            return "fa-paint-brush";

        if (c.Contains("cerraj"))
            return "fa-key";

        return "fa-wrench";
    }

}

@section Styles {
    <link rel="stylesheet"
          href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/4.7.0/css/font-awesome.min.css">

    
    <link rel="stylesheet"
          href="~/css/home.css"
          asp-append-version="true" />
    

}

<!-- =========================================================
     1. HERO / BUSCAR SERVICIO
     ========================================================= -->

<section class="hero-section">

    
    <div class="hero-overlay"></div>

    <div class="site-container">
        <div class="hero-content">

            <div class="hero-badge">
                <i class="fa fa-check-circle"></i>
                Servicios profesionales en Costa Rica
            </div>

            <h1>
                ENCUENTRA EL TÉCNICO QUE NECESITAS,
                <span>CUANDO LO NECESITAS.</span>
            </h1>

            <p>
                Conecta con técnicos calificados para servicios de
                fontanería, electricidad, tecnología, reparaciones,
                mantenimiento y mucho más.
            </p>

            <div class="hero-actions">

                <a asp-controller="SolicitudServicio"
                   asp-action="Paso1Servicio"
                   class="btn btn-brand btn-lg hero-primary-btn">
                    <i class="fa fa-search"></i>
                    Buscar un servicio
                </a>

                <a href="#como-funciona"
                   class="btn hero-secondary-btn">
                    <i class="fa fa-play-circle"></i>
                    ¿Cómo funciona?
                </a>

            </div>

            <div class="hero-trust">

                <div class="hero-trust-item">
                    <i class="fa fa-users"></i>
                    <span>Técnicos especializados</span>
                </div>

                <div class="hero-trust-item">
                    <i class="fa fa-map-marker"></i>
                    <span>Servicios cerca de ti</span>
                </div>

                <div class="hero-trust-item">
                    <i class="fa fa-shield"></i>
                    <span>Servicio confiable</span>
                </div>

            </div>

        </div>
    </div>
    

</section>

<!-- =========================================================
     2. SERVICIOS DESTACADOS
     ========================================================= -->

<section id="servicios" class="services-section home-section">

    
    <div class="site-container">

        <div class="section-heading text-center">

            <span class="section-kicker">
                ENCUENTRA LO QUE NECESITAS
            </span>

            <h2>Servicios destacados</h2>

            <p>
                Encuentra profesionales para resolver las necesidades
                de tu hogar, negocio o tecnología.
            </p>

        </div>

        @if (Model != null && Model.Any())
        {
            <div class="row g-4">

                @foreach (var servicio in Model.Take(8))
                {
                    <div class="col-12 col-sm-6 col-lg-3">

                        <div class="service-card">

                            <div class="service-icon">
                                <i class="fa @IconoPara(servicio.Categoria?.NombreCategoria)"></i>
                            </div>

                            <h3>
                                @servicio.NombreServicio
                            </h3>

                            <p>
                                @servicio.Descripcion
                            </p>

                            <div class="service-price">
                                Desde
                                @servicio.TarifaDiagnosticoBase.ToString("N0")
                                @servicio.Moneda
                            </div>

                            <a asp-controller="SolicitudesReserva"
                               asp-action="Create"
                               asp-route-servicioId="@servicio.ServicioID"
                               class="btn btn-brand w-100">
                                <i class="fa fa-calendar-check-o"></i>
                                Agendar
                            </a>

                        </div>

                    </div>
                }

            </div>
        }
        else
        {
            <div class="empty-services">
                <i class="fa fa-wrench"></i>

                <h3>Servicios próximamente</h3>

                <p>
                    Estamos preparando nuestros servicios para ti.
                </p>
            </div>
        }

        <div class="section-action">

            <a asp-controller="Servicios"
               asp-action="Index"
               class="btn btn-outline-secondary btn-lg">
                <i class="fa fa-th-large"></i>
                Ver todos los servicios
            </a>

        </div>

    </div>
    

</section>

<!-- =========================================================
     3. ¿CÓMO FUNCIONA?
     ========================================================= -->

<section id="como-funciona" class="how-section home-section">

    
    <div class="site-container">

        <div class="section-heading text-center">

            <span class="section-kicker">
                SIMPLE, RÁPIDO Y CONFIABLE
            </span>

            <h2>¿Cómo funciona CURLINGgo?</h2>

            <p>
                Solicitar un servicio profesional nunca había sido tan sencillo.
            </p>

        </div>

        <div class="steps-container">

            <div class="step-card">

                <div class="step-number">
                    01
                </div>

                <div class="step-icon">
                    <i class="fa fa-search"></i>
                </div>

                <h3>Selecciona un servicio</h3>

                <p>
                    Elige la categoría y el servicio que necesitas.
                </p>

            </div>


            <div class="step-card">

                <div class="step-number">
                    02
                </div>

                <div class="step-icon">
                    <i class="fa fa-file-text-o"></i>
                </div>

                <h3>Cuéntanos qué necesitas</h3>

                <p>
                    Responde unas preguntas y describe el trabajo que necesitas realizar.
                </p>

            </div>


            <div class="step-card">

                <div class="step-number">
                    03
                </div>

                <div class="step-icon">
                    <i class="fa fa-map-marker"></i>
                </div>

                <h3>Indica tu ubicación</h3>

                <p>
                    Utilizamos tu ubicación para ayudarte a encontrar técnicos disponibles cerca de ti.
                </p>

            </div>


            <div class="step-card">

                <div class="step-number">
                    04
                </div>

                <div class="step-icon">
                    <i class="fa fa-user"></i>
                </div>

                <h3>Encuentra un técnico</h3>

                <p>
                    Los técnicos disponibles reciben tu solicitud y pueden aceptar el servicio.
                </p>

            </div>


            <div class="step-card">

                <div class="step-number">
                    05
                </div>

                <div class="step-icon">
                    <i class="fa fa-check"></i>
                </div>

                <h3>Realiza el servicio</h3>

                <p>
                    Coordina con el técnico y recibe el servicio solicitado.
                </p>

            </div>


            <div class="step-card">

                <div class="step-number">
                    06
                </div>

                <div class="step-icon">
                    <i class="fa fa-star"></i>
                </div>

                <h3>Califica la experiencia</h3>

                <p>
                    Al finalizar, comparte tu experiencia y ayuda a mejorar CURLINGgo.
                </p>

            </div>

        </div>

    </div>
    

</section>

