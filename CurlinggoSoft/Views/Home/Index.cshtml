@model List<CurlinggoSoft.Models.Servicio>
@{
    ViewData["Title"] = "Inicio";

    // Ícono según la categoría del servicio (solo estético; si el nombre no
    // matchea con nada, cae en el ícono genérico de llave).
    string IconoPara(string? categoria)
    {
        var c = (categoria ?? "").ToLowerInvariant();
        if (c.Contains("fontan") || c.Contains("plomer") || c.Contains("fuga")) return "fa-wrench";
        if (c.Contains("electric")) return "fa-bolt";
        if (c.Contains("soporte") || c.Contains("red") || c.Contains("cómputo") || c.Contains("computo") || c.Contains("tecnología") || c.Contains("tecnologia")) return "fa-desktop";
        if (c.Contains("handyman") || c.Contains("reparac")) return "fa-hammer";
        if (c.Contains("limpieza")) return "fa-tint";
        if (c.Contains("pintura")) return "fa-paint-brush";
        if (c.Contains("cerraj")) return "fa-key";
        return "fa-wrench";
    }
}

@section Styles {
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/4.7.0/css/font-awesome.min.css">
    <link rel="stylesheet" href="~/css/home.css" asp-append-version="true" />
}

<!-- ============ HERO ============ -->
<div class="hero-section">
    <div class="site-container">
        <div class="hero-content">
            <h1>SOLUCIONES TÉCNICAS PARA TU HOGAR EN COSTA RICA.</h1>
            <p>Técnicos calificados en fontanería, electricidad, cómputo y más. Precios fijos, pago seguro y garantía de servicio.</p>
            <a asp-controller="SolicitudServicio" asp-action="Paso1Servicio" class="btn btn-brand btn-lg">
                <i class="fa fa-search"></i> Buscar Servicio
            </a>
        </div>
    </div>
</div>

<!-- ============ SERVICIOS DESTACADOS ============ -->
<div class="services-section site-container">
    <h2>Nuestros Servicios</h2>

    @if (Model != null && Model.Any())
    {
        <div class="row g-4">
            @foreach (var servicio in Model)
            {
                <div class="col-12 col-sm-6 col-lg-3">
                    <div class="service-card">
                        <div class="service-icon">
                            <i class="fa @IconoPara(servicio.Categoria?.NombreCategoria)"></i>
                        </div>
                        <h3>@servicio.NombreServicio</h3>
                        <p>@servicio.Descripcion</p>
                        <div class="service-price">
                            Desde @servicio.TarifaDiagnosticoBase.ToString("N0") @servicio.Moneda
                        </div>
                        <a asp-controller="SolicitudesReserva" asp-action="Create" asp-route-servicioId="@servicio.ServicioID" class="btn btn-brand w-100">
                            Agendar
                        </a>
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <p class="text-muted">Todavía no hay servicios activos para mostrar.</p>
    }

    <div class="text-center mt-4">
        <a asp-controller="Servicios" asp-action="Index" class="btn btn-outline-secondary btn-lg">
            Ver todos los servicios
        </a>
    </div>
</div>