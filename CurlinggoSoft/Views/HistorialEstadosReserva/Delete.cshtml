@model CurlinggoSoft.Models.HistorialEstadoReserva
@{ ViewData["Title"] = "Eliminar Historial"; }
<h1>Eliminar Registro de Historial</h1>
<div class="alert alert-warning"><h4>¿Está seguro?</h4></div>
<dl class="row">
    <dt class="col-sm-2">Reserva</dt><dd class="col-sm-10">@Model.ReservaID</dd>
</dl>
<form asp-action="Delete">
    <input type="hidden" asp-for="HistorialID" />
    <button type="submit" class="btn btn-danger">Eliminar</button>
    <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
</form>
