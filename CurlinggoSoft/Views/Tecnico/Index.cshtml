@model IEnumerable<CurlinggoSoft.Models.SolicitudReserva>

@{
    ViewData["Title"] = "Panel de Técnico";
}

<div class="container my-4">
    <h2 class="fw-bold mb-3"><i class="fa fa-briefcase"></i> Panel de Control - Técnico</h2>
    <p class="text-muted mb-4">Revisa tus trabajos asignados y mantén actualizada tu disponibilidad.</p>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">@TempData["Success"]</div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-warning">@TempData["Error"]</div>
    }

    <p class="small text-muted" id="estadoUbicacion">
        <i class="bi bi-geo-alt"></i> Detectando tu ubicación para poder asignarte servicios cercanos...
    </p>

    <!-- Zona de cobertura manual: garantiza que el técnico reciba ofertas
         incluso si nunca da permiso de GPS, o si su navegador lo bloquea.
         Es el respaldo de "Nivel 3" del motor de despacho. -->
    <div class="card shadow-sm p-3 mb-4">
        <h6 class="mb-1"><i class="bi bi-map"></i> Mi zona de cobertura</h6>
        <p class="text-muted small mb-2">
            Esto garantiza que sigas recibiendo ofertas aunque no compartas tu ubicación GPS.
            No reemplaza al GPS — es un respaldo.
        </p>
        <div class="row g-2 align-items-end">
            <div class="col-sm-5">
                <label class="form-label small mb-1" for="provinciaCobertura">Provincia</label>
                <select id="provinciaCobertura" class="form-select form-select-sm">
                    <option value="">Cargando...</option>
                </select>
            </div>
            <div class="col-sm-5">
                <label class="form-label small mb-1" for="cantonCobertura">Cantón</label>
                <select id="cantonCobertura" class="form-select form-select-sm" disabled>
                    <option value="">-- Selecciona primero la provincia --</option>
                </select>
            </div>
            <div class="col-sm-2">
                <button type="button" id="btnGuardarCobertura" class="btn btn-primary btn-sm w-100">Guardar</button>
            </div>
        </div>
        <p class="small mt-2 mb-0" id="estadoCobertura"></p>
    </div>

    <div class="row mb-4">
        <div class="col-md-6">
            <div class="card shadow-sm p-3 text-center">
                <h5>Radar de Ofertas <span id="badgeOfertas" class="badge bg-danger d-none">0</span></h5>
                <p class="text-muted small">Consulta solicitudes cercanas pendientes de aceptar.</p>
                <a asp-action="OfertasDisponibles" class="btn btn-primary btn-sm">Ver Ofertas Disponibles</a>
            </div>
        </div>
        <div class="col-md-6">
            <div class="card shadow-sm p-3 text-center">
                <h5>Mi Disponibilidad Horaria</h5>
                <p class="text-muted small">Configura los días y horas que laboras.</p>
                <a asp-controller="DisponibilidadTecnico" asp-action="Index" class="btn btn-outline-secondary btn-sm">Configurar Horarios</a>
            </div>
        </div>
    </div>

    <h3 class="fw-bold mt-4 mb-3">Mis Trabajos Asignados</h3>
    @if (!Model.Any())
    {
        <div class="alert alert-info">No tienes trabajos asignados en este momento. Revisa las ofertas disponibles.</div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-striped align-middle">
                <thead class="table-dark">
                    <tr>
                        <th>Fecha</th>
                        <th>Servicio</th>
                        <th>Dirección</th>
                        <th>Estado</th>
                        <th>Acción</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var trabajo in Model)
                    {
                        <tr>
                            <td>@trabajo.FechaHoraProgramada.ToString("dd/MM/yyyy HH:mm")</td>
                            <td>@(trabajo.Servicio?.NombreServicio ?? "N/A")</td>
                            <td>@trabajo.DireccionServicio</td>
                            <td><span class="badge bg-warning text-dark">@(trabajo.EstadoReserva?.Nombre ?? "Asignada")</span></td>
                            <td>
                                <span class="text-muted small">En progreso</span>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

@Html.AntiForgeryToken()

@section Scripts {
    <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/8.0.0/signalr.min.js"></script>
    <script>
        // --- Captura de ubicación al entrar al panel (igual que el wizard
        //     del cliente en Paso4direccion.cshtml). Sin esto,
        //     usp_Tecnico_ActualizarUbicacion nunca se llama y el técnico
        //     jamás aparece en usp_Reserva_BuscarTecnicosDisponibles. ---
        const estadoUbicacion = document.getElementById('estadoUbicacion');

        function enviarUbicacion(lat, lon) {
            const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value;
            const form = new FormData();
            form.append('latitud', lat);
            form.append('longitud', lon);
            if (token) form.append('__RequestVerificationToken', token);

            fetch('@Url.Action("ActualizarUbicacion", "Tecnico")', { method: 'POST', body: form })
                .then(resp => {
                    estadoUbicacion.innerHTML = resp.ok
                        ? '<i class="bi bi-geo-alt-fill text-success"></i> Ubicación actualizada. Recibirás ofertas de tu zona.'
                        : '<i class="bi bi-geo-alt text-warning"></i> No se pudo actualizar tu ubicación, reintenta más tarde.';
                })
                .catch(() => {
                    estadoUbicacion.innerHTML = '<i class="bi bi-geo-alt text-warning"></i> No se pudo actualizar tu ubicación.';
                });
        }

        function capturarUbicacion() {
            if (!navigator.geolocation) {
                estadoUbicacion.innerHTML = '<i class="bi bi-geo-alt text-warning"></i> Tu navegador no soporta geolocalización.';
                return;
            }
            navigator.geolocation.getCurrentPosition(
                p => enviarUbicacion(p.coords.latitude, p.coords.longitude),
                () => { estadoUbicacion.innerHTML = '<i class="bi bi-geo-alt text-warning"></i> Necesitamos tu ubicación para asignarte servicios cercanos. Actívala en los permisos del navegador y recarga esta página.'; },
                { enableHighAccuracy: false, timeout: 8000, maximumAge: 60000 }
            );
        }
        capturarUbicacion();
        setInterval(capturarUbicacion, 5 * 60 * 1000);

        // --- Zona de cobertura manual (Nivel 3 de respaldo) ---
        const provinciaCobertura = document.getElementById('provinciaCobertura');
        const cantonCobertura = document.getElementById('cantonCobertura');
        const estadoCobertura = document.getElementById('estadoCobertura');

        async function cargarProvincias() {
            try {
                const resp = await fetch('@Url.Action("GetProvincias", "Tecnico")');
                const provincias = await resp.json();
                provinciaCobertura.innerHTML = '<option value="">-- Selecciona --</option>' +
                    provincias.map(p => `<option value="${p.id}">${p.nombre}</option>`).join('');
            } catch (e) {
                provinciaCobertura.innerHTML = '<option value="">Error al cargar</option>';
            }
        }
        cargarProvincias();

        provinciaCobertura.addEventListener('change', async function () {
            const provinciaId = this.value;
            cantonCobertura.innerHTML = '<option value="">Cargando...</option>';
            cantonCobertura.disabled = true;
            if (!provinciaId) {
                cantonCobertura.innerHTML = '<option value="">-- Selecciona primero la provincia --</option>';
                return;
            }
            const resp = await fetch(`@Url.Action("GetCantones", "Tecnico")?provinciaId=${provinciaId}`);
            const cantones = await resp.json();
            cantonCobertura.innerHTML = '<option value="">-- Selecciona --</option>' +
                cantones.map(c => `<option value="${c.id}">${c.nombre}</option>`).join('');
            cantonCobertura.disabled = false;
        });

        document.getElementById('btnGuardarCobertura').addEventListener('click', async function () {
            const provinciaId = provinciaCobertura.value;
            const cantonId = cantonCobertura.value;
            if (!provinciaId || !cantonId) {
                estadoCobertura.innerHTML = '<span class="text-danger">Selecciona provincia y cantón.</span>';
                return;
            }
            const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value;
            const form = new FormData();
            form.append('provinciaCoberturaId', provinciaId);
            form.append('cantonCoberturaId', cantonId);
            if (token) form.append('__RequestVerificationToken', token);

            const resp = await fetch('@Url.Action("ActualizarZonaCobertura", "Tecnico")', { method: 'POST', body: form });
            estadoCobertura.innerHTML = resp.ok
                ? '<span class="text-success"><i class="bi bi-check-circle"></i> Zona guardada.</span>'
                : '<span class="text-danger">No se pudo guardar la zona.</span>';
        });

        // --- Badge de ofertas pendientes: se actualiza al instante por
        //     SignalR, con un poll lento (60s) como respaldo. ---
        async function actualizarBadge() {
            try {
                const resp = await fetch('@Url.Action("ContarOfertasPendientes", "Tecnico")');
                if (!resp.ok) return;
                const data = await resp.json();
                const badge = document.getElementById('badgeOfertas');
                if (data.count > 0) {
                    badge.textContent = data.count;
                    badge.classList.remove('d-none');
                } else {
                    badge.classList.add('d-none');
                }
            } catch (e) { /* silencioso */ }
        }
        actualizarBadge();
        setInterval(actualizarBadge, 60000);

        const connection = new signalR.HubConnectionBuilder()
            .withUrl('/hubs/notificaciones')
            .withAutomaticReconnect()
            .build();

        connection.on('NuevaOferta', actualizarBadge);
        connection.on('OfertaYaTomada', actualizarBadge);
        connection.start().catch(err => console.warn('Sin conexión en tiempo real, usando respaldo por polling.', err));
    </script>
}
