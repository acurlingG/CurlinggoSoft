@model IEnumerable<CurlinggoSoft.Models.DisponibilidadTecnico>

@{
    ViewData["Title"] = "Mi Disponibilidad";

    string NombreDia(byte dia) => dia switch
    {
        1 => "Lunes",
        2 => "Martes",
        3 => "Miércoles",
        4 => "Jueves",
        5 => "Viernes",
        6 => "Sábado",
        7 => "Domingo",
        _ => "Desconocido"
    };
}

<div class="container my-4">
    <h2 class="fw-bold mb-3">
        <i class="fa fa-clock-o"></i> Mi Disponibilidad
    </h2>
    <p class="text-muted">
        Configura tu disponibilidad horaria para recibir ofertas de servicios. 
        Solo tú puedes modificar tu horario.
    </p>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="fa fa-check-circle"></i> @TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Cerrar"></button>
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="fa fa-exclamation-circle"></i> @TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Cerrar"></button>
        </div>
    }

    <div class="mb-3">
        <a asp-action="AgregarDisponibilidad" class="btn btn-success">
            <i class="fa fa-plus-circle"></i> Agregar Nueva Disponibilidad
        </a>
    </div>

    @if (!Model.Any())
    {
        <div class="alert alert-info">
            <i class="fa fa-info-circle"></i>
            Aún no has configurado tu disponibilidad. 
            <a asp-action="AgregarDisponibilidad" class="alert-link">Agrega tu primer horario ahora</a>.
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-striped table-hover align-middle shadow-sm">
                <thead class="table-dark">
                    <tr>
                        <th><i class="fa fa-calendar"></i> Día</th>
                        <th><i class="fa fa-arrow-right"></i> Hora Inicio</th>
                        <th><i class="fa fa-arrow-left"></i> Hora Fin</th>
                        <th><i class="fa fa-info-circle"></i> Estado</th>
                        <th class="text-center"><i class="fa fa-cogs"></i> Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>
                                <strong>@NombreDia(item.DiaSemana)</strong>
                            </td>
                            <td>
                                <code>@item.HoraInicio</code>
                            </td>
                            <td>
                                <code>@item.HoraFin</code>
                            </td>
                            <td>
                                @if (item.Activa)
                                {
                                    <span class="badge bg-success">
                                        <i class="fa fa-check"></i> Activa
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-danger">
                                        <i class="fa fa-times"></i> Inactiva
                                    </span>
                                }
                            </td>
                            <td class="text-center">
                                <div class="btn-group" role="group">
                                    <a asp-action="EditarMiDisponibilidad" asp-route-id="@item.DisponibilidadID" 
                                       class="btn btn-warning btn-sm" title="Editar disponibilidad">
                                        <i class="fa fa-edit"></i> Editar
                                    </a>

                                    <form asp-action="EliminarDisponibilidad" asp-route-id="@item.DisponibilidadID" 
                                          method="post" style="display:inline;" 
                                          onsubmit="return confirm('¿Eliminar este horario de disponibilidad?');">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-danger btn-sm" title="Eliminar disponibilidad">
                                            <i class="fa fa-trash"></i> Eliminar
                                        </button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <div class="mt-3">
            <p class="text-muted small">
                <i class="fa fa-lightbulb-o"></i>
                <strong>Consejo:</strong> Mantén tu disponibilidad actualizada para que clientes 
                te asignen trabajos en tus horarios disponibles.
            </p>
        </div>
    }
</div>
