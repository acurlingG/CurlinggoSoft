@model CurlinggoSoft.Models.EstadoReserva
@{ ViewData["Title"] = "Detalles"; }
<h1>Detalles de Estado</h1>
<div><dl class="row"><dt class="col-sm-2">Código</dt><dd class="col-sm-10">@Model.Codigo</dd><dt class="col-sm-2">Nombre</dt><dd class="col-sm-10">@Model.Nombre</dd><dt class="col-sm-2">Orden Flujo</dt><dd class="col-sm-10">@Model.OrdenFlujo</dd></dl></div>
<div><a asp-action="Edit" asp-route-id="@Model.EstadoReservaID" class="btn btn-warning">Editar</a> <a asp-action="Index" class="btn btn-secondary">Volver</a></div>
