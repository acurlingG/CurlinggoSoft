@model IEnumerable<CurlinggoSoft.Models.OfertaTecnico>
@{ ViewData["Title"] = "Ofertas Técnico"; }
<h1>Ofertas a Técnicos</h1>
<p><a asp-action="Create" class="btn btn-primary">+ Nueva Oferta</a></p>

<form method="get" asp-action="Index" class="row g-2 mb-3">
    <div class="col-auto">
        <select name="tecnicoId" class="form-select" onchange="this.form.submit()">
            <option value="">-- Todos los técnicos --</option>
            @foreach (var item in (Microsoft.AspNetCore.Mvc.Rendering.SelectList)ViewBag.Tecnicos)
            {
                <option value="@item.Value" selected="@(item.Value == (string)ViewBag.TecnicoIDSeleccionado)">@item.Text</option>
            }
        </select>
    </div>
    <div class="col-auto">
        <button type="submit" class="btn btn-outline-secondary">Filtrar</button>
        <a asp-action="Index" class="btn btn-outline-secondary">Limpiar</a>
    </div>
</form>

<table class="table table-striped table-hover">
    <thead class="table-dark"><tr><th>Reserva</th><th>Técnico</th><th>Estado</th><th>Distancia</th><th>Fecha Envío</th><th>Acciones</th></tr></thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.Reserva?.ReservaID</td>
                <td>@item.Tecnico?.IdentificacionCedula</td>
                <td>@item.EstadoOferta?.Nombre</td>
                <td>@item.DistanciaMetros</td>
                <td>@item.FechaEnvio</td>
                <td>
                    <a asp-action="Details" asp-route-id="@item.OfertaTecnicoID" class="btn btn-info btn-sm">Ver</a>
                    <a asp-action="Edit" asp-route-id="@item.OfertaTecnicoID" class="btn btn-warning btn-sm">Editar</a>
                    <a asp-action="Delete" asp-route-id="@item.OfertaTecnicoID" class="btn btn-danger btn-sm">Eliminar</a>
                </td>
            </tr>
        }
    </tbody>
</table>
<div><a asp-action="Index" asp-controller="Admin" class="btn btn-secondary mt-3">← Volver al Admin</a></div>
