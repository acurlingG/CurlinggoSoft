@model CurlinggoSoft.Models.OfertaTecnico
@{ ViewData["Title"] = "Crear Oferta"; }
<h1>Crear Oferta a Técnico</h1>
<div class="row"><div class="col-md-6">
<form asp-action="Create">
    <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
    <div class="mb-3"><label asp-for="ReservaID" class="form-label"></label><select asp-for="ReservaID" class="form-select" asp-items="ViewBag.ReservaID"></select></div>
    <div class="mb-3"><label asp-for="TecnicoID" class="form-label"></label><select asp-for="TecnicoID" class="form-select" asp-items="ViewBag.TecnicoID"></select></div>
    <div class="mb-3"><label asp-for="EstadoOfertaID" class="form-label"></label><select asp-for="EstadoOfertaID" class="form-select" asp-items="ViewBag.EstadoOfertaID"></select></div>
    <div class="mb-3"><label asp-for="DistanciaMetros" class="form-label"></label><input asp-for="DistanciaMetros" type="number" step="0.01" class="form-control" /></div>
    <div class="mb-3"><label asp-for="OrdenOferta" class="form-label"></label><input asp-for="OrdenOferta" type="number" class="form-control" /></div>
    <div class="mb-3"><label asp-for="FechaExpiracion" class="form-label"></label><input asp-for="FechaExpiracion" type="datetime-local" class="form-control" /></div>
    <div class="mb-3"><label asp-for="Mensaje" class="form-label"></label><textarea asp-for="Mensaje" class="form-control"></textarea></div>
    <div><button type="submit" class="btn btn-primary">Guardar</button> <a asp-action="Index" class="btn btn-secondary">Cancelar</a></div>
</form>
</div></div>
@section Scripts { @{await Html.RenderPartialAsync("_ValidationScriptsPartial");} }
