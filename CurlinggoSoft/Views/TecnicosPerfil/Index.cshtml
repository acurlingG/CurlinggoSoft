@model IEnumerable<CurlinggoSoft.Models.TecnicoPerfil>
@{
    ViewData["Title"] = "Perfiles Técnicos";
    var usuarios = ViewData["Usuarios"] as Dictionary<string, CurlinggoSoft.Models.Usuario>;
}
<h1>Perfiles de Técnicos</h1>
<p><a asp-action="Create" class="btn btn-primary">+ Nuevo Perfil Técnico</a></p>
<table class="table table-striped table-hover">
    <thead class="table-dark">
        <tr><th>Técnico</th><th>Cédula</th><th>Estado</th><th>Calificación</th><th>Disponible</th><th>Cobertura</th><th>Acciones</th></tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            CurlinggoSoft.Models.Usuario? usuario = null;
            usuarios?.TryGetValue(item.TecnicoID, out usuario);
            <tr>
                <td>
                    @if (usuario != null)
                    {
                        <div>@usuario.Nombre @usuario.Apellidos</div>
                        <small class="text-muted">@usuario.Email</small>
                    }
                    else
                    {
                        @item.TecnicoID
                    }
                </td>
                <td>@item.IdentificacionCedula</td>
                <td>@item.EstadoVerificacion</td>
                <td>@item.CalificacionPromedio</td>
                <td><span class="badge @(item.Disponible ? "bg-success" : "bg-secondary")">@(item.Disponible ? "Sí" : "No")</span></td>
                <td>@item.ProvinciaCobertura?.Nombre / @item.CantonCobertura?.Nombre</td>
                <td>
                    <a asp-action="Details" asp-route-id="@item.TecnicoID" class="btn btn-info btn-sm">Ver</a>
                    <a asp-action="Edit" asp-route-id="@item.TecnicoID" class="btn btn-warning btn-sm">Editar</a>
                    <a asp-action="Delete" asp-route-id="@item.TecnicoID" class="btn btn-danger btn-sm">Eliminar</a>
                </td>
            </tr>
        }
    </tbody>
</table>
<div><a asp-action="Index" asp-controller="Admin" class="btn btn-secondary mt-3">← Volver al Admin</a></div>
