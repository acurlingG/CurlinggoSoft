@model CurlinggoSoft.Models.TecnicoPerfil
@{ ViewData["Title"] = "Crear Técnico Perfil"; }
<h1>Crear Perfil de Técnico</h1>
<div class="row">
    <div class="col-md-6">
        <form asp-action="Create">
            <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
            <div class="mb-3">
                <label asp-for="TecnicoID" class="form-label">Técnico (usuario)</label>
                <select asp-for="TecnicoID" class="form-select" asp-items="ViewBag.TecnicoID">
                    <option value="">-- Seleccione un técnico --</option>
                </select>
                <span asp-validation-for="TecnicoID" class="text-danger"></span>
                <small class="form-text text-muted">Solo se listan usuarios con rol "Tecnico" que aún no tienen un perfil creado.</small>
            </div>
            <div class="mb-3">
                <label asp-for="IdentificacionCedula" class="form-label"></label>
                <input asp-for="IdentificacionCedula" class="form-control" />
                <span asp-validation-for="IdentificacionCedula" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="EstadoVerificacion" class="form-label"></label>
                <select asp-for="EstadoVerificacion" class="form-select">
                    <option value="Pendiente">Pendiente</option>
                    <option value="Aprobado">Aprobado</option>
                    <option value="Rechazado">Rechazado</option>
                    <option value="Suspendido">Suspendido</option>
                </select>
            </div>
            <div class="mb-3">
                <label asp-for="CalificacionPromedio" class="form-label"></label>
                <input asp-for="CalificacionPromedio" type="number" step="0.01" min="0" max="9.99" class="form-control" />
                <small class="form-text text-muted">Valor permitido entre 0.00 y 9.99</small>
                <span asp-validation-for="CalificacionPromedio" class="text-danger"></span>
            </div>
            <div class="form-check mb-3">
                <input asp-for="Disponible" type="checkbox" class="form-check-input" />
                <label class="form-check-label" for="Disponible">Disponible</label>
            </div>
            <div class="mb-3">
                <label asp-for="ProvinciaCoberturaID" class="form-label"></label>
                <select asp-for="ProvinciaCoberturaID" class="form-select" asp-items="ViewBag.ProvinciaCoberturaID"><option value="">-- Ninguna --</option></select>
            </div>
            <div class="mb-3">
                <label asp-for="CantonCoberturaID" class="form-label"></label>
                <select asp-for="CantonCoberturaID" class="form-select" asp-items="ViewBag.CantonCoberturaID"><option value="">-- Ninguno --</option></select>
            </div>
            <div><button type="submit" class="btn btn-primary">Guardar</button> <a asp-action="Index" class="btn btn-secondary">Cancelar</a></div>
        </form>
    </div>
</div>
@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    <script>
        function cargarCantonesCobertura(provinciaId, cantonSeleccionado) {
            var $canton = $('#CantonCoberturaID');
            $canton.empty().append('<option value="">-- Ninguno --</option>');
            if (!provinciaId) { return; }
            $.getJSON('/Cantones/PorProvincia', { provinciaId: provinciaId }, function (data) {
                $.each(data, function (i, item) {
                    $canton.append($('<option></option>').val(item.cantonID).text(item.nombre));
                });
                if (cantonSeleccionado) { $canton.val(cantonSeleccionado); }
            });
        }

        $(document).ready(function () {
            $('#ProvinciaCoberturaID').change(function () {
                cargarCantonesCobertura($(this).val());
            });
        });
    </script>
}
