@model CurlinggoSoft.Models.ConfiguracionDespacho

@{
    ViewData["Title"] = "Configuración de Despacho";
}

<h1>Configuración de Despacho de Técnicos</h1>
<p class="text-muted">
    Ajuste el radio de búsqueda y el máximo de técnicos candidatos que utiliza el motor
    de despacho automático (procedimiento <code>usp_Reserva_BuscarTecnicosDisponibles</code>).
</p>

@if (TempData["Mensaje"] != null)
{
    <div class="alert alert-success">@TempData["Mensaje"]</div>
}

<div class="row">
    <div class="col-md-6">
        <form asp-action="Edit" method="post">
            <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

            <input type="hidden" asp-for="ConfiguracionDespachoID" />

            <div class="mb-3">
                <label asp-for="RadioKm" class="form-label"></label>
                <input asp-for="RadioKm" class="form-control" />
                <span asp-validation-for="RadioKm" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="MaxTecnicos" class="form-label"></label>
                <input asp-for="MaxTecnicos" class="form-control" />
                <span asp-validation-for="MaxTecnicos" class="text-danger"></span>
            </div>

            @if (Model.FechaActualizacion != default)
            {
                <p class="text-muted">Última actualización: @Model.FechaActualizacion.ToString("g")</p>
            }

            <div class="mb-3">
                <button type="submit" class="btn btn-warning">Guardar</button>
                <a asp-action="Index" asp-controller="Admin" class="btn btn-secondary">Volver</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
