@model IEnumerable<CurlinggoSoft.Models.SubcategoriaServicio>
@{ ViewData["Title"] = "Subcategorías de Servicio"; }
<h1>Subcategorías de Servicio</h1>
<p><a asp-action="Create" class="btn btn-primary">+ Nueva Subcategoría</a></p>
<table class="table table-striped table-hover">
    <thead class="table-dark">
        <tr><th>Categoría</th><th>Nombre</th><th>Descripción</th><th>Activa</th><th>Acciones</th></tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@Html.DisplayFor(modelItem => item.Categoria.NombreCategoria)</td>
                <td>@Html.DisplayFor(modelItem => item.NombreSubcategoria)</td>
                <td>@Html.DisplayFor(modelItem => item.Descripcion)</td>
                <td><span class="badge @(item.Activa ? "bg-success" : "bg-danger")">@(item.Activa ? "Activa" : "Inactiva")</span></td>
                <td>
                    <a asp-action="Edit" asp-route-id="@item.SubcategoriaID" class="btn btn-warning btn-sm">Editar</a>
                    <a asp-action="Delete" asp-route-id="@item.SubcategoriaID" class="btn btn-danger btn-sm">Eliminar</a>
                </td>
            </tr>
        }
    </tbody>
</table>
<div><a asp-action="Index" asp-controller="Admin" class="btn btn-secondary mt-3">← Volver al Admin</a></div>
@section Scripts { @{await Html.RenderPartialAsync("_ValidationScriptsPartial");} }
