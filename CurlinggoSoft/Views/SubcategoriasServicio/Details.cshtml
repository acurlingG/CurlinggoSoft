@model CurlinggoSoft.Models.SubcategoriaServicio
@{ ViewData["Title"] = "Detalles"; }
<h1>Detalles de Subcategoría</h1>
<div><h4>CurlinggoSoft.Models.SubcategoriaServicio</h4><hr />
    <dl class="row">
        <dt class="col-sm-2">Categoría</dt>
        <dd class="col-sm-10">@Html.DisplayFor(model => model.Categoria.NombreCategoria)</dd>
        <dt class="col-sm-2">Nombre</dt>
        <dd class="col-sm-10">@Html.DisplayFor(model => model.NombreSubcategoria)</dd>
        <dt class="col-sm-2">Descripción</dt>
        <dd class="col-sm-10">@Html.DisplayFor(model => model.Descripcion)</dd>
        <dt class="col-sm-2">Activa</dt>
        <dd class="col-sm-10"><span class="badge @(Model.Activa ? "bg-success" : "bg-danger")">@(Model.Activa ? "Activa" : "Inactiva")</span></dd>
    </dl>
</div>
<div><a asp-action="Edit" asp-route-id="@Model.SubcategoriaID" class="btn btn-warning">Editar</a> <a asp-action="Index" class="btn btn-secondary">Volver</a></div>
