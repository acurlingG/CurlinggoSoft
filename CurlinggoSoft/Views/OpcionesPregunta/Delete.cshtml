@model CurlinggoSoft.Models.OpcionPregunta
@{ ViewData["Title"] = "Eliminar Opción"; }
<h1>Eliminar Opción de Pregunta</h1>
<div class="alert alert-warning"><h4>¿Está seguro?</h4></div>
<dl class="row">
    <dt class="col-sm-2">Texto Opción</dt><dd class="col-sm-10">@Model.TextoOpcion</dd>
</dl>
<form asp-action="Delete">
    <input type="hidden" asp-for="OpcionPreguntaID" />
    <button type="submit" class="btn btn-danger">Eliminar</button>
    <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
</form>
