@model CurlinggoSoft.Models.OpcionPregunta
@{ ViewData["Title"] = "Crear Opción"; }
<h1>Crear Opción de Pregunta</h1>
<div class="row">
    <div class="col-md-6">
        <form asp-action="Create">
            <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
            <div class="mb-3">
                <label asp-for="PreguntaServicioID" class="form-label"></label>
                <select asp-for="PreguntaServicioID" class="form-select" asp-items="ViewBag.PreguntaServicioID"></select>
            </div>
            <div class="mb-3">
                <label asp-for="TextoOpcion" class="form-label"></label>
                <input asp-for="TextoOpcion" class="form-control" />
                <span asp-validation-for="TextoOpcion" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="Valor" class="form-label"></label>
                <input asp-for="Valor" class="form-control" />
            </div>
            <div class="mb-3">
                <label asp-for="Orden" class="form-label"></label>
                <input asp-for="Orden" type="number" class="form-control" />
            </div>
            <div class="form-check mb-3">
                <input type="hidden" name="Activa" value="false" />
                <input asp-for="Activa" type="checkbox" class="form-check-input" />
                <label class="form-check-label" for="Activa">Activa</label>
            </div>
            <div><button type="submit" class="btn btn-primary">Guardar</button> <a asp-action="Index" class="btn btn-secondary">Cancelar</a></div>
        </form>
    </div>
</div>
@section Scripts { @{await Html.RenderPartialAsync("_ValidationScriptsPartial");} }
