@model CurlinggoSoft.Models.OpcionPregunta
@{ ViewData["Title"] = "Detalles Opción"; }
<h1>Detalles de Opción</h1>
<dl class="row">
    <dt class="col-sm-2">Pregunta</dt><dd class="col-sm-10">@Model.Pregunta?.TextoPregunta</dd>
    <dt class="col-sm-2">Texto Opción</dt><dd class="col-sm-10">@Model.TextoOpcion</dd>
    <dt class="col-sm-2">Valor</dt><dd class="col-sm-10">@Model.Valor</dd>
</dl>
<div>
    <a asp-action="Edit" asp-route-id="@Model.OpcionPreguntaID" class="btn btn-warning">Editar</a>
    <a asp-action="Index" class="btn btn-secondary">Volver</a>
</div>
