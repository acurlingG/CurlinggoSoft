@model IEnumerable<CurlinggoSoft.Models.OpcionPregunta>
@{ ViewData["Title"] = "Opciones Pregunta"; }
<h1>Opciones de Pregunta</h1>
<p><a asp-action="Create" class="btn btn-primary">+ Nueva Opción</a></p>
<table class="table table-striped table-hover">
    <thead class="table-dark">
        <tr><th>Pregunta</th><th>Texto Opción</th><th>Valor</th><th>Orden</th><th>Acciones</th></tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.Pregunta?.TextoPregunta</td>
                <td>@item.TextoOpcion</td>
                <td>@item.Valor</td>
                <td>@item.Orden</td>
                <td>
                    <a asp-action="Details" asp-route-id="@item.OpcionPreguntaID" class="btn btn-info btn-sm">Ver</a>
                    <a asp-action="Edit" asp-route-id="@item.OpcionPreguntaID" class="btn btn-warning btn-sm">Editar</a>
                    <a asp-action="Delete" asp-route-id="@item.OpcionPreguntaID" class="btn btn-danger btn-sm">Eliminar</a>
                </td>
            </tr>
        }
    </tbody>
</table>
<div><a asp-action="Index" asp-controller="Admin" class="btn btn-secondary mt-3">← Volver al Admin</a></div>
