@model CurlinggoSoft.Models.MetodoPago
@{ ViewData["Title"] = "Eliminar Método de Pago"; }
<h1>Eliminar Método de Pago</h1>
<div class="alert alert-warning"><h4>¿Está seguro?</h4></div>
<div><dl class="row"><dt class="col-sm-2">Código</dt><dd class="col-sm-10">@Model.Codigo</dd><dt class="col-sm-2">Nombre</dt><dd class="col-sm-10">@Model.Nombre</dd></dl>
<form asp-action="Delete"><input type="hidden" asp-for="MetodoPagoID" /><button type="submit" class="btn btn-danger">Eliminar</button> <a asp-action="Index" class="btn btn-secondary">Cancelar</a></form></div>
@section Scripts { @{await Html.RenderPartialAsync("_ValidationScriptsPartial");} }
