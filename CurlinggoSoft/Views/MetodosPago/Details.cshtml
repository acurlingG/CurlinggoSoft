@model CurlinggoSoft.Models.MetodoPago
@{ ViewData["Title"] = "Detalles"; }
<h1>Detalles de Método de Pago</h1>
<div><dl class="row"><dt class="col-sm-2">Código</dt><dd class="col-sm-10">@Model.Codigo</dd><dt class="col-sm-2">Nombre</dt><dd class="col-sm-10">@Model.Nombre</dd><dt class="col-sm-2">Activo</dt><dd class="col-sm-10"><span class="badge @(Model.Activo ? "bg-success" : "bg-danger")">@(Model.Activo ? "Activo" : "Inactivo")</span></dd></dl></div>
<div><a asp-action="Edit" asp-route-id="@Model.MetodoPagoID" class="btn btn-warning">Editar</a> <a asp-action="Index" class="btn btn-secondary">Volver</a></div>
