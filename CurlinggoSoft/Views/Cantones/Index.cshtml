@model IEnumerable<CurlinggoSoft.Models.Canton>

@{
    ViewData["Title"] = "Cantones";
}

<h1>Cantones</h1>

<p>
    <a asp-action="Create" class="btn btn-primary">+ Nuevo Cantón</a>
</p>

<table class="table table-striped table-hover">
    <thead class="table-dark">
        <tr>
            <th>Provincia</th>
            <th>@Html.DisplayNameFor(model => model.FirstOrDefault().Nombre)</th>
            <th>@Html.DisplayNameFor(model => model.FirstOrDefault().CodigoDTA)</th>
            <th>@Html.DisplayNameFor(model => model.FirstOrDefault().Activo)</th>
            <th>Acciones</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@Html.DisplayFor(modelItem => item.Provincia.Nombre)</td>
                <td>@Html.DisplayFor(modelItem => item.Nombre)</td>
                <td>@Html.DisplayFor(modelItem => item.CodigoDTA)</td>
                <td>
                    <span class="badge @(item.Activo ? "bg-success" : "bg-danger")">
                        @(item.Activo ? "Activo" : "Inactivo")
                    </span>
                </td>
                <td>
                    <a asp-action="Edit" asp-route-cantonid="@item.CantonID" class="btn btn-warning btn-sm">Editar</a>
                    <a asp-action="Details" asp-route-cantonid="@item.CantonID" class="btn btn-info btn-sm">Ver</a>
                    <a asp-action="Delete" asp-route-cantonid="@item.CantonID" class="btn btn-danger btn-sm">Eliminar</a>
                </td>
            </tr>
        }
    </tbody>
</table>

<div>
    <a asp-action="Index" asp-controller="Admin" class="btn btn-secondary mt-3">← Volver al Admin</a>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
